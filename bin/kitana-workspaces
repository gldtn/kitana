#!/bin/bash

set -euo pipefail

if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  exit 0
fi

lock_file="${XDG_RUNTIME_DIR:-/tmp}/kitana-workspaces.lock"
exec 9>"$lock_file"
flock -n 9 || exit 0

monitors_json=""

refresh_monitors_json() {
  monitors_json="$(hyprctl monitors -j 2>/dev/null || true)"
  [ -n "$monitors_json" ] && [ "$monitors_json" != "[]" ]
}

for _ in {1..10}; do
  if refresh_monitors_json; then
    break
  fi
  sleep 0.5
done

refresh_monitors_json || exit 0

apply_workspace_rules() {
  while IFS=$'\t' read -r workspace monitor; do
    [ -n "$workspace" ] && [ -n "$monitor" ] || continue
    hyprctl eval "hl.workspace_rule({ workspace = \"$workspace\", monitor = \"$monitor\", persistent = true })" >/dev/null 2>&1 || true
    hyprctl dispatch moveworkspacetomonitor "$workspace $monitor" >/dev/null 2>&1 || true
  done < <(jq -r '
    [ .[]? | select((.disabled // false) | not) | select((.name // "") != "") ]
    | sort_by((.x // 0), (.id // 0))
    | if length == 0 then empty
      elif length == 1 then
        .[0].name as $monitor
        | range(1; 11)
        | "\(.)\t\($monitor)"
      else
        .[0].name as $primary
        | .[1].name as $secondary
        | (range(1; 6) | "\(.)\t\($primary)"),
          (range(6; 11) | "\(.)\t\($secondary)")
      end
  ' <<<"$monitors_json" 2>/dev/null || true)
}

apply_workspace_rules
sleep 1
refresh_monitors_json || exit 0
apply_workspace_rules

active_workspace="$(hyprctl activeworkspace -j | jq -r '.id // 1' 2>/dev/null || printf '1')"

if [ "$active_workspace" -lt 1 ] || [ "$active_workspace" -gt 10 ]; then
  hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })' >/dev/null 2>&1 || true
fi
