#!/bin/bash

set -euo pipefail

config_name="kitana"
config_file="$HOME/.config/quickshell/$config_name/shell.qml"
colors_file="$HOME/.config/quickshell/$config_name/Config/Colors.qml"
kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
kitana_qml_import_dir="${KITANA_QML_IMPORT_DIR:-$HOME/.local/lib/kitana/qml}"
kitana_lib_dir="${KITANA_LIB_DIR:-$HOME/.local/lib}"
theme_file="$HOME/.config/kitana/theme"
log_file="/tmp/kitana-quickshell.log"
action="${1:-reload}"

prepend_path() {
  local entry="$1"
  local current="$2"

  case ":$current:" in
    *":$entry:"*)
      printf '%s\n' "$current"
      ;;
    *)
      if [ -n "$current" ]; then
        printf '%s:%s\n' "$entry" "$current"
      else
        printf '%s\n' "$entry"
      fi
      ;;
  esac
}

export QS_NO_RELOAD_POPUP=1
export QML2_IMPORT_PATH="$(prepend_path "$kitana_qml_import_dir" "${QML2_IMPORT_PATH:-}")"
export QML_IMPORT_PATH="$(prepend_path "$kitana_qml_import_dir" "${QML_IMPORT_PATH:-}")"
export LD_LIBRARY_PATH="$(prepend_path "$kitana_lib_dir" "${LD_LIBRARY_PATH:-}")"

if ! command -v quickshell >/dev/null 2>&1; then
  exit 0
fi

case "$action" in
  --start) action="start" ;;
  --stop) action="stop" ;;
  --restart) action="restart" ;;
  --reload) action="reload" ;;
esac

is_running() {
  quickshell ipc -c "$config_name" show >/dev/null 2>&1
}

wait_until_running() {
  for _ in {1..20}; do
    is_running && return 0
    sleep 0.1
  done

  return 1
}

wait_until_stopped() {
  for _ in {1..20}; do
    ! is_running && return 0
    sleep 0.1
  done

  return 1
}

prepare_theme() {
  [ -x "$kitana_dir/bin/kitana-theme-quickshell" ] || return 0
  [ -f "$theme_file" ] || return 0

  if [ "$(<"$theme_file")" = "matugen" ]; then
    return 0
  fi

  "$kitana_dir/bin/kitana-theme-quickshell" --render-only "$(<"$theme_file")" >/dev/null 2>&1 || true
}

prepare_polkit_agent() {
  command -v systemctl >/dev/null 2>&1 || return 0

  if native_polkit_enabled; then
    systemctl --user stop hyprpolkitagent >/dev/null 2>&1 || true
  else
    systemctl --user start hyprpolkitagent >/dev/null 2>&1 || true
  fi
}

native_polkit_enabled() {
  [ "${KITANA_POLKIT_AGENT:-1}" != "0" ]
}

start_quickshell() {
  if is_running; then
    return 0
  fi

  prepare_theme
  prepare_polkit_agent
  quickshell --daemonize --no-duplicate --config "$config_name" >"$log_file" 2>&1
  if ! wait_until_running >/dev/null 2>&1 && native_polkit_enabled; then
    systemctl --user start hyprpolkitagent >/dev/null 2>&1 || true
  fi
}

stop_quickshell() {
  quickshell kill -c "$config_name" >/dev/null 2>&1 || true
  wait_until_stopped >/dev/null 2>&1 || true
}

reload_quickshell() {
  if ! is_running; then
    start_quickshell
    return
  fi

  prepare_theme
  if quickshell ipc -c "$config_name" call kitana-shell reload >/dev/null 2>&1; then
    return
  fi

  [ -f "$colors_file" ] && touch "$colors_file"
  touch "$config_file"
}

case "$action" in
  start)
    start_quickshell
    ;;
  stop)
    stop_quickshell
    ;;
  restart)
    stop_quickshell
    start_quickshell
    ;;
  reload)
    reload_quickshell
    ;;
  -h|--help|help)
    printf 'Usage: kitana-quickshell [start|stop|restart|reload]\n'
    ;;
  *)
    printf 'Usage: kitana-quickshell [start|stop|restart|reload]\n' >&2
    exit 2
    ;;
esac
