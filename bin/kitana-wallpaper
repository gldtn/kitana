#!/bin/bash

set -euo pipefail

kitana_config="$HOME/.config/kitana/config"
env_wall_dir="${KITANA_WALLPAPER_DIR:-}"

if [ -f "$kitana_config" ]; then
  # shellcheck disable=SC1090
  source "$kitana_config"
fi

wall_dir="${env_wall_dir:-${KITANA_WALLPAPER_DIR:-$HOME/.config/kitana/wallpapers}}"
default_wall_dir="${KITANA_DIR:-$HOME/.local/share/kitana}/default/wallpapers"
hyprpaper_config="$HOME/.config/hypr/hyprpaper.conf"
state_dir="$HOME/.config/kitana"
state_file="$state_dir/wallpaper"
current_wallpaper="$state_dir/current-wallpaper"
sddm_background="${KITANA_SDDM_BACKGROUND:-/var/lib/kitana/sddm/background}"
sddm_wallpaper_state="$state_dir/sddm-wallpaper"
fit_mode="${KITANA_WALLPAPER_FIT:-cover}"
awww_resize="${KITANA_AWWW_RESIZE:-crop}"
awww_transition="${KITANA_AWWW_TRANSITION:-random}"
awww_duration="${KITANA_AWWW_DURATION:-3}"
awww_step="${KITANA_AWWW_STEP:-90}"
awww_fps="${KITANA_AWWW_FPS:-60}"
awww_angle="${KITANA_AWWW_TRANSITION_ANGLE:-45}"
awww_pos="${KITANA_AWWW_TRANSITION_POS:-center}"
awww_bezier="${KITANA_AWWW_TRANSITION_BEZIER:-.54,0,.34,.99}"

wallpapers=()
while IFS= read -r wallpaper; do
  wallpapers+=("$wallpaper")
done < <(find -L "$wall_dir" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.gif" -o -iname "*.avif" \) 2>/dev/null | sort -V)

selected=""
restore=0

case "${1:-}" in
  --dir)
    printf '%s\n' "$wall_dir"
    exit 0
    ;;
  --list)
    printf '%s\n' "${wallpapers[@]}"
    exit 0
    ;;
  --restore)
    restore=1
    ;;
  "")
    ;;
  *)
    selected="$1"
    ;;
esac

if [ "$restore" -eq 1 ]; then
  if [ -f "$state_file" ]; then
    selected="$(<"$state_file")"
    if [ ! -f "$selected" ]; then
      migrated="$wall_dir/$(basename "$selected")"
      [ -f "$migrated" ] && selected="$migrated"
    fi
  else
    selected="$wall_dir/kitana-wallpaper-001.jpg"
    [ -f "$selected" ] || selected="$default_wall_dir/kitana-wallpaper-001.jpg"
  fi
elif [ -z "$selected" ]; then
  if [ "${#wallpapers[@]}" -eq 0 ]; then
    echo "No wallpapers found in $wall_dir"
    exit 1
  fi

  if command -v fzf >/dev/null 2>&1; then
    selected_name="$(printf '%s\n' "${wallpapers[@]##*/}" | fzf --prompt='Wallpaper > ' || true)"
    [ -n "$selected_name" ] || exit 0
    selected="$wall_dir/$selected_name"
  else
    echo "Install fzf or use kitana-wallpaper-grid to choose a wallpaper interactively."
    exit 1
  fi

  [ -n "$selected" ] || exit 0
fi

if [ ! -f "$selected" ]; then
  echo "wallpaper not found: $selected"
  exit 1
fi

mkdir -p "$(dirname "$hyprpaper_config")" "$state_dir"
printf '%s\n' "$selected" >"$state_file"
ln -sfn "$selected" "$current_wallpaper"

cat >"$hyprpaper_config" <<EOF
# Kitana managed Hyprpaper config

splash = false
ipc = true

wallpaper {
    monitor =
    path = $selected
    fit_mode = $fit_mode
}
EOF

sync_sddm_background() {
  local source="$1"
  local current=""
  local current_resolved=""
  local source_resolved=""

  [ -f "$sddm_background" ] || return 0
  [ -w "$sddm_background" ] || return 0

  source_resolved="$(readlink -f "$source" 2>/dev/null || printf '%s' "$source")"

  if [ -f "$sddm_wallpaper_state" ] && [ "$(<"$sddm_wallpaper_state")" = "$source_resolved" ]; then
    return 0
  fi

  {
    if [ -f "$state_file" ]; then
      current="$(<"$state_file")"
    fi
    current_resolved="$(readlink -f "$current" 2>/dev/null || printf '%s' "$current")"
    [ "$current_resolved" = "$source_resolved" ] || exit 0

    cp --reflink=auto -- "$source_resolved" "$sddm_background" 2>/dev/null || cp -- "$source_resolved" "$sddm_background" 2>/dev/null || exit 0
    chmod 0644 "$sddm_background" 2>/dev/null || true
    printf '%s\n' "$source_resolved" >"$sddm_wallpaper_state"
  } >/tmp/kitana-sddm-wallpaper.log 2>&1 &
}

apply_awww() {
  command -v awww >/dev/null 2>&1 || return 1
  command -v awww-daemon >/dev/null 2>&1 || return 1

  if ! awww query >/dev/null 2>&1; then
    awww-daemon >/tmp/kitana-awww.log 2>&1 &
    sleep 0.4
  fi

  awww img "$selected" \
    --resize "$awww_resize" \
    --transition-type "$awww_transition" \
    --transition-duration "$awww_duration" \
    --transition-step "$awww_step" \
    --transition-fps "$awww_fps" \
    --transition-angle "$awww_angle" \
    --transition-pos "$awww_pos" \
    --transition-bezier "$awww_bezier" >/dev/null 2>&1

  pkill -x hyprpaper 2>/dev/null || true
}

apply_hyprpaper() {
  command -v hyprctl >/dev/null 2>&1 || return 1
  command -v hyprpaper >/dev/null 2>&1 || return 1

  if ! hyprctl hyprpaper wallpaper ",$selected,$fit_mode" >/dev/null 2>&1; then
    pkill -x hyprpaper 2>/dev/null || true
    hyprpaper >/tmp/kitana-hyprpaper.log 2>&1 &
    sleep 0.3
    hyprctl hyprpaper wallpaper ",$selected,$fit_mode" >/dev/null 2>&1
  fi
}

backend="awww"
if ! apply_awww; then
  backend="hyprpaper"
  apply_hyprpaper
fi

sync_sddm_background "$selected"

if [ ! -f "$state_dir/theme" ]; then
  "${KITANA_DIR:-$HOME/.local/share/kitana}/bin/kitana-matugen" "$selected"
fi

echo "Wallpaper set with $backend: $selected"
