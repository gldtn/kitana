#!/bin/bash

set -euo pipefail

CONFIG_FILE="$HOME/.config/kitana/password-manager.conf"
PASSWORD_MANAGER=""

if [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

if [ -z "$PASSWORD_MANAGER" ] || [ "$PASSWORD_MANAGER" = "none" ]; then
  echo "No password manager configured. Run kitana-install-password-manager to choose one." >&2
  exit 1
fi

if command -v "$PASSWORD_MANAGER" >/dev/null 2>&1; then
  exec "$PASSWORD_MANAGER" "$@"
fi

echo "Configured password manager is not available: $PASSWORD_MANAGER" >&2
exit 1
