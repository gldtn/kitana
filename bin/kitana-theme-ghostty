#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
lua_path="$kitana_dir/lib/?.lua;$kitana_dir/lib/?/init.lua;;"
ghostty_config_dir="$HOME/.config/ghostty"
ghostty_theme_file="$ghostty_config_dir/kitana-theme.conf"
ghostty_dynamic_theme_file="$ghostty_config_dir/themes/kitana-dynamic"
theme="${1:-}"
theme_env=""

if [ -z "$theme" ]; then
  printf 'Usage: %s THEME\n' "$(basename "$0")" >&2
  exit 2
fi

theme_env="$(LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" env "$theme")" || exit 1
eval "$theme_env"

if [ -z "$ghostty_theme" ] && [ -z "$ghostty_source_file" ]; then
  exit 0
fi

mkdir -p "$ghostty_config_dir"

if [ -n "$ghostty_source_file" ]; then
  mkdir -p "$(dirname "$ghostty_dynamic_theme_file")"
  cp "$kitana_dir/$ghostty_source_file" "$ghostty_dynamic_theme_file"
  printf '# Kitana managed Ghostty theme\nconfig-file = ?%s\n' "$ghostty_dynamic_theme_file" >"$ghostty_theme_file"
else
  printf '# Kitana managed Ghostty theme\ntheme = %s\n' "$ghostty_theme" >"$ghostty_theme_file"
fi

if command -v ghostty >/dev/null 2>&1 && [ -f "$ghostty_config_dir/config" ]; then
  ghostty +validate-config --config-file="$ghostty_config_dir/config" >/dev/null || true
fi

if systemctl --user is-active --quiet app-com.mitchellh.ghostty.service 2>/dev/null; then
  systemctl reload --user app-com.mitchellh.ghostty.service >/dev/null 2>&1 || true
elif pgrep -x ghostty >/dev/null 2>&1; then
  killall -SIGUSR2 ghostty >/dev/null 2>&1 || true
fi
