#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
ghostty_config_dir="$HOME/.config/ghostty"
ghostty_theme_file="$ghostty_config_dir/kitana-theme.conf"
theme="${1:-}"
theme_env=""

if [ -z "$theme" ]; then
  printf 'Usage: %s THEME\n' "$(basename "$0")" >&2
  exit 2
fi

theme_env="$(lua "$kitana_dir/lib/kitana-theme.lua" env "$theme")" || exit 1
eval "$theme_env"
[ -n "$ghostty_theme" ] || exit 0

mkdir -p "$ghostty_config_dir"
printf '# Kitana managed Ghostty theme\ntheme = %s\n' "$ghostty_theme" >"$ghostty_theme_file"

if command -v ghostty >/dev/null 2>&1 && [ -f "$ghostty_config_dir/config" ]; then
  ghostty +validate-config --config-file="$ghostty_config_dir/config" >/dev/null
fi

if systemctl --user is-active --quiet app-com.mitchellh.ghostty.service 2>/dev/null; then
  systemctl reload --user app-com.mitchellh.ghostty.service >/dev/null 2>&1 || true
elif pgrep -x ghostty >/dev/null 2>&1; then
  killall -SIGUSR2 ghostty >/dev/null 2>&1 || true
fi
