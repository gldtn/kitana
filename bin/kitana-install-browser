#!/usr/bin/env bash

set -euo pipefail

KITANA_DIR="${KITANA_DIR:-$HOME/.local/share/kitana}"
CONFIG_FILE="$HOME/.config/webapp-install.conf"
apply_mime=0
set_default=0

# shellcheck source=../install/lib/install.sh
source "$KITANA_DIR/install/lib/install.sh"

usage() {
    printf 'Usage: %s [--current|--apply-mime|--set-default]\n' "$(basename "$0")"
}

current_browser() {
    local browser=""
    if [ -f "$CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
        browser="${BROWSER:-}"
    fi

    if [ -n "$browser" ]; then
        printf '%s\n' "$browser"
    else
        printf 'No browser configured.\n' >&2
        return 1
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --current)
            current_browser
            exit $?
            ;;
        --apply-mime)
            apply_mime=1
            ;;
        --set-default)
            set_default=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if ! command -v yay >/dev/null 2>&1; then
    echo "Error: yay is not installed. Please install it first."
    exit 1
fi

if ! command -v gum >/dev/null 2>&1; then
    echo "Error: gum is required for interactive browser selection."
    exit 1
fi

"$KITANA_DIR/bin/kitana-show-logo"
gum format -- "## Browser Installation Script"
echo ""

# package:executable:description
browsers=(
    "brave-origin-beta-bin:brave-origin-beta:Minimalist Brave Origin beta browser"
    "brave-bin:brave:Fast and privacy-focused browser"
    "chromium:chromium:Open-source version of Chrome"
    "firefox:firefox:Popular open-source browser"
    "google-chrome:google-chrome-stable:Google's proprietary browser"
    "qutebrowser:qutebrowser:Keyboard-oriented browser"
    "zen-browser-bin:zen-browser:Web browser based on Mozilla Firefox"
)

save_browser_choice() {
    mkdir -p "$HOME/.config"
    printf 'BROWSER=%s\n' "$1" >"$CONFIG_FILE"
}

seed_brave_defaults() {
    local browser_exec="$1"
    local local_state=""
    local experiment="brave-change-active-tab-on-scroll-event"
    local disabled_experiment="$experiment@2"
    local tmp_file

    case "$browser_exec" in
        brave)
            local_state="$HOME/.config/BraveSoftware/Brave-Browser/Local State"
            ;;
        brave-origin-beta)
            local_state="$HOME/.config/BraveSoftware/Brave-Origin-Beta/Local State"
            ;;
        *)
            return 0
            ;;
    esac

    if [ -f "$local_state" ] && grep -q "\"$experiment@" "$local_state"; then
        return 0
    fi

    mkdir -p "$(dirname "$local_state")"

    if [ ! -f "$local_state" ]; then
        printf '{"browser":{"enabled_labs_experiments":["%s"]}}\n' "$disabled_experiment" >"$local_state"
        return 0
    fi

    if ! command -v jq >/dev/null 2>&1; then
        echo "Skipping Brave tab-scroll default; jq is not available."
        return 0
    fi

    tmp_file="$(mktemp)"
    if jq --arg experiment "$experiment" --arg disabled_experiment "$disabled_experiment" '
        if (.browser.enabled_labs_experiments // [] | any(startswith($experiment + "@"))) then
            .
        else
            .browser.enabled_labs_experiments = ((.browser.enabled_labs_experiments // []) + [$disabled_experiment])
        end
    ' "$local_state" >"$tmp_file"; then
        cp "$tmp_file" "$local_state"
    else
        echo "Skipping Brave tab-scroll default; could not update: $local_state"
    fi

    rm -f "$tmp_file"
}

install_browser_package() {
    local pkg_name="$1"
    local browser_exec="$2"
    local command=(yay -S --noconfirm --needed "$pkg_name")
    local retry=(yay -S --noconfirm --needed --answerclean All "$pkg_name")
    local exit_code

    echo "Installing $pkg_name..."
    if kitana_run_logged "apps/browser" "$pkg_name" "browser" "${command[@]}"; then
        save_browser_choice "$browser_exec"
        seed_brave_defaults "$browser_exec"
        gum style --foreground 2 "Successfully installed $pkg_name!"
        return 0
    fi

    exit_code="${KITANA_LAST_EXIT_CODE:-1}"
    kitana_log_failure "apps/browser" "$pkg_name" "${command[*]}" "$exit_code" "yay -S $pkg_name" "${KITANA_LAST_COMMAND_LOG:-}"

    echo "$pkg_name install failed. Retrying with a clean AUR build..."
    if kitana_run_logged "apps/browser" "$pkg_name" "browser-clean-retry" "${retry[@]}"; then
        save_browser_choice "$browser_exec"
        seed_brave_defaults "$browser_exec"
        kitana_log_report "Browser package succeeded after clean retry: $pkg_name"
        gum style --foreground 2 "Successfully installed $pkg_name after clean retry!"
        return 0
    fi

    exit_code="${KITANA_LAST_EXIT_CODE:-1}"
    kitana_log_failure "apps/browser" "$pkg_name" "${retry[*]}" "$exit_code" "yay -S --answerclean All $pkg_name" "${KITANA_LAST_COMMAND_LOG:-}"

    if command -v "$browser_exec" >/dev/null 2>&1; then
        save_browser_choice "$browser_exec"
        seed_brave_defaults "$browser_exec"
        echo "WARNING: $pkg_name failed, but $browser_exec is already available. Continuing."
        return 0
    fi

    gum style --foreground 1 "Failed to install $pkg_name. Check yay output for details."
    return 1
}

set_default_browser() {
    local browser_exec="$1"

    if ! command -v "$browser_exec" >/dev/null 2>&1; then
        echo "$browser_exec is not installed. Run $(basename "$0") --apply-mime to install and set it as default."
        return 1
    fi

    save_browser_choice "$browser_exec"
    seed_brave_defaults "$browser_exec"
    bash "$KITANA_DIR/install/apps/mimetypes.sh"
    gum style --foreground 2 "Default browser set to $browser_exec."
}

selected="$(gum choose --header "Select a browser to install or set as default:" "${browsers[@]}" | cut -d':' -f1-2)"

if [ -z "$selected" ]; then
    echo "No browser selected."
    exit 1
fi

pkg_name="${selected%%:*}"
browser_exec="${selected#*:}"

if [ "$set_default" -eq 1 ]; then
    set_default_browser "$browser_exec"
elif gum confirm "Install or set $pkg_name as the browser?"; then
    install_browser_package "$pkg_name" "$browser_exec"
else
    gum style --foreground 3 "Installation cancelled."
    exit 0
fi

if [ "$apply_mime" -eq 1 ] && [ "$set_default" -eq 0 ]; then
    bash "$KITANA_DIR/install/apps/mimetypes.sh"
fi
