#!/usr/bin/env bash

set -euo pipefail

KITANA_DIR="${KITANA_DIR:-$HOME/.local/share/kitana}"
CONFIG_FILE="$HOME/.config/kitana/password-manager.conf"

# shellcheck source=../install/lib/install.sh
source "$KITANA_DIR/install/lib/install.sh"

usage() {
    printf 'Usage: %s [--current|--set-default]\n' "$(basename "$0")"
}

save_password_manager_choice() {
    mkdir -p "$(dirname "$CONFIG_FILE")"
    printf 'PASSWORD_MANAGER=%q\n' "$1" >"$CONFIG_FILE"
}

current_password_manager() {
    local password_manager=""

    if [ -f "$CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
        password_manager="${PASSWORD_MANAGER:-}"
    fi

    if [ -n "$password_manager" ]; then
        printf '%s\n' "$password_manager"
    else
        printf 'No password manager configured.\n' >&2
        return 1
    fi
}

install_password_manager_package() {
    local pkg_names="$1"
    local password_exec="$2"
    local exit_code
    local pkg_array=()

    if [ "$pkg_names" = "none" ]; then
        save_password_manager_choice "$password_exec"
        gum style --foreground 2 "Password manager launcher disabled."
        return 0
    fi

    read -r -a pkg_array <<<"$pkg_names"
    local command=(yay -S --noconfirm --needed "${pkg_array[@]}")
    local retry=(yay -S --noconfirm --needed --answerclean All "${pkg_array[@]}")

    echo "Installing $pkg_names..."
    if kitana_run_logged "apps/password-manager" "$pkg_names" "password-manager" "${command[@]}"; then
        save_password_manager_choice "$password_exec"
        gum style --foreground 2 "Successfully installed $pkg_names!"
        return 0
    fi

    exit_code="${KITANA_LAST_EXIT_CODE:-1}"
    kitana_log_failure "apps/password-manager" "$pkg_names" "${command[*]}" "$exit_code" "yay -S $pkg_names" "${KITANA_LAST_COMMAND_LOG:-}"

    echo "$pkg_names install failed. Retrying with a clean AUR build..."
    if kitana_run_logged "apps/password-manager" "$pkg_names" "password-manager-clean-retry" "${retry[@]}"; then
        save_password_manager_choice "$password_exec"
        kitana_log_report "Password manager package succeeded after clean retry: $pkg_names"
        gum style --foreground 2 "Successfully installed $pkg_names after clean retry!"
        return 0
    fi

    exit_code="${KITANA_LAST_EXIT_CODE:-1}"
    kitana_log_failure "apps/password-manager" "$pkg_names" "${retry[*]}" "$exit_code" "yay -S --answerclean All $pkg_names" "${KITANA_LAST_COMMAND_LOG:-}"

    if [ "$password_exec" != "none" ] && command -v "$password_exec" >/dev/null 2>&1; then
        save_password_manager_choice "$password_exec"
        echo "WARNING: $pkg_names failed, but $password_exec is already available. Continuing."
        return 0
    fi

    gum style --foreground 1 "Failed to install $pkg_names. Check yay output for details."
    return 1
}

set_default_password_manager() {
    local password_exec="$1"

    if [ "$password_exec" != "none" ] && ! command -v "$password_exec" >/dev/null 2>&1; then
        echo "$password_exec is not installed. Run $(basename "$0") to install and set it as default."
        return 1
    fi

    save_password_manager_choice "$password_exec"
    gum style --foreground 2 "Default password manager set to $password_exec."
}

set_default=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --current)
            current_password_manager
            exit $?
            ;;
        --set-default)
            set_default=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if ! command -v yay >/dev/null 2>&1; then
    echo "Error: yay is not installed. Please install it first."
    exit 1
fi

if ! command -v gum >/dev/null 2>&1; then
    echo "Error: gum is required for interactive password manager selection."
    exit 1
fi

"$KITANA_DIR/bin/kitana-show-logo"
gum format -- "## Password Manager Selection"
echo ""

# package:executable:description
password_managers=(
    "1password-beta 1password-cli:1password:1Password beta desktop app and CLI"
    "bitwarden:bitwarden:Bitwarden desktop app"
    "keepassxc:keepassxc:KeePassXC local password manager"
    "none:none:Do not configure a password manager hotkey"
)

selected="$(gum choose --header "Select a password manager to install or set as default:" "${password_managers[@]}" | cut -d':' -f1-2)"

if [ -z "$selected" ]; then
    echo "No password manager selected."
    exit 1
fi

pkg_names="${selected%%:*}"
password_exec="${selected#*:}"

if [ "$set_default" -eq 1 ]; then
    set_default_password_manager "$password_exec"
elif [ "$pkg_names" = "none" ] || gum confirm "Install or set $pkg_names as the password manager?"; then
    install_password_manager_package "$pkg_names" "$password_exec"
else
    gum style --foreground 3 "Installation cancelled."
    exit 0
fi
