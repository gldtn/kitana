#!/bin/bash

set -euo pipefail

KITANA_DIR="${KITANA_DIR:-$HOME/.local/share/kitana}"
SOURCE_THEME="$KITANA_DIR/default/sddm/theme"
TARGET_THEME="/usr/share/sddm/themes/kitana"
TARGET_HYPRLAND="/usr/share/sddm/hyprland.lua"
WAYLAND_CONF="/etc/sddm.conf.d/10-wayland.conf"
THEME_CONF="/etc/sddm.conf.d/20-theme.conf"
DEFAULT_BACKGROUND="$KITANA_DIR/default/wallpapers/kitana-wallpaper-001.jpg"

DRY_RUN=0
RUN_TEST=0

usage() {
  cat <<EOF
Usage: kitana-refresh-sddm [--dry-run] [--test-mode]

Refresh Kitana's SDDM compositor config and theme.

Options:
  --dry-run    Print actions without changing system files
  --test-mode  Launch sddm-greeter test mode after refreshing
EOF
}

run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+'
    local arg
    for arg in "$@"; do
      printf ' %q' "$arg"
    done
    printf '\n'
  else
    "$@"
  fi
}

write_wayland_conf() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+ write %s\n' "$WAYLAND_CONF"
    return
  fi

  sudo tee "$WAYLAND_CONF" >/dev/null <<EOF
[General]
DisplayServer=wayland

[Wayland]
CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.lua
EOF
}

write_theme_conf() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+ write %s\n' "$THEME_CONF"
    return
  fi

  sudo tee "$THEME_CONF" >/dev/null <<EOF
[Theme]
Current=kitana
EOF
}

remove_old_dropins() {
  run sudo rm -f /usr/share/sddm/hyprland.conf /etc/kitana/sddm-hyprland.conf

  if [ -f /etc/sddm.conf.d/20-hyprland.conf ] && grep -q '/etc/kitana/sddm-hyprland.conf' /etc/sddm.conf.d/20-hyprland.conf; then
    run sudo rm -f /etc/sddm.conf.d/20-hyprland.conf
  fi

  if [ -f /etc/sddm.conf.d/10-theme.conf ] && grep -q '^Current=pixie$' /etc/sddm.conf.d/10-theme.conf; then
    run sudo rm -f /etc/sddm.conf.d/10-theme.conf
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    --test-mode)
      RUN_TEST=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [ ! -f "$KITANA_DIR/default/sddm/hyprland.lua" ]; then
  echo "Missing SDDM Hyprland config: $KITANA_DIR/default/sddm/hyprland.lua" >&2
  exit 1
fi

if [ ! -d "$SOURCE_THEME" ]; then
  echo "Missing SDDM theme source: $SOURCE_THEME" >&2
  exit 1
fi

run sudo mkdir -p /usr/share/sddm /usr/share/sddm/themes /etc/sddm.conf.d
run sudo cp "$KITANA_DIR/default/sddm/hyprland.lua" "$TARGET_HYPRLAND"
remove_old_dropins
run sudo rm -rf "$TARGET_THEME"
run sudo cp -r "$SOURCE_THEME" "$TARGET_THEME"

if [ -e "$HOME/.config/kitana/current-wallpaper" ]; then
  run sudo cp -L "$HOME/.config/kitana/current-wallpaper" "$TARGET_THEME/background"
elif [ -f "$DEFAULT_BACKGROUND" ]; then
  run sudo cp "$DEFAULT_BACKGROUND" "$TARGET_THEME/background"
fi

write_wayland_conf
write_theme_conf

echo "Kitana SDDM theme refreshed."
echo "Test with: sddm-greeter --test-mode --theme $TARGET_THEME"

if [ "$RUN_TEST" -eq 1 ]; then
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "+ sddm-greeter --test-mode --theme $TARGET_THEME"
  else
    sddm-greeter --test-mode --theme "$TARGET_THEME"
  fi
fi
