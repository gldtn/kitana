#!/bin/bash

set -euo pipefail

size=256
output=""

usage() {
  echo "Usage: kitana-wallpaper-thumbnail [--size PX] --output PATH SOURCE" >&2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --size)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      size="$2"
      shift 2
      ;;
    --output)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      output="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

source_path="${1:-}"

if [ -z "$source_path" ] || [ -z "$output" ]; then
  usage
  exit 2
fi

case "$size" in
  ''|*[!0-9]*)
    echo "Invalid thumbnail size: $size" >&2
    exit 2
    ;;
esac

if [ ! -f "$source_path" ]; then
  echo "Wallpaper not found: $source_path" >&2
  exit 1
fi

if [ -s "$output" ] && [ "$output" -nt "$source_path" ]; then
  printf '%s\n' "$output"
  exit 0
fi

if ! command -v ffmpegthumbnailer >/dev/null 2>&1; then
  echo "ffmpegthumbnailer is not installed" >&2
  exit 127
fi

mkdir -p "$(dirname "$output")"
tmp="${output}.$$.$RANDOM.tmp.png"
trap 'rm -f "$tmp"' EXIT

ffmpegthumbnailer \
  -i "$source_path" \
  -o "$tmp" \
  -s "$size" \
  -q 8 >/dev/null 2>&1

mv -f "$tmp" "$output"
printf '%s\n' "$output"
