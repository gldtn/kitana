#!/bin/bash

set -euo pipefail

source_value="${1:-$HOME/.config/kitana/current-wallpaper}"
target="$HOME/.config/quickshell/kitana/Config/Colors.qml"
legacy_target="$HOME/.config/quickshell/kitana/Colors.qml"
mkdir -p "$(dirname "$target")"

remove_legacy_target() {
  if [ -f "$legacy_target" ] && grep -q "Kitana managed Quickshell colors" "$legacy_target"; then
    rm "$legacy_target"
  fi
}

reload_quickshell() {
  if [ "${KITANA_NO_RELOAD:-}" = 1 ]; then
    return 0
  fi

  "${KITANA_DIR:-$HOME/.local/share/kitana}/bin/kitana-quickshell" >/dev/null 2>&1 || true
}

finish() {
  remove_legacy_target
  echo "$1"
  reload_quickshell
  exit 0
}

generate_colors() {
  python - "$1" "$2" "$target" <<'PY'
import colorsys
import json
import pathlib
import sys

mode, source, target_path = sys.argv[1], sys.argv[2], pathlib.Path(sys.argv[3])

direct_roles = [
    "foreground", "foregroundStrong", "foregroundMuted", "foregroundSubtle", "foregroundInverted",
    "accent", "accentStrong", "onAccent",
    "background", "surface", "surfaceContainer", "surfaceCard", "surfaceControl", "surfaceSubtle", "surfaceHover", "surfacePressed", "surfaceFloating", "surfaceFloatingStrong",
    "border", "borderMuted", "borderStrong", "borderFocus",
    "info", "success", "warning", "danger",
    "iconPrimary", "iconSecondary", "iconMuted", "iconSubtle",
]

def normalize(color):
    color = color.strip()
    if len(color) == 8 and not color.startswith("#"):
        color = color[2:]
    if color.startswith("#") and len(color) == 9:
        color = "#" + color[3:]
    return "#" + color.lstrip("#")

def write_qml(sources):
    lines = [
        "// Kitana managed Quickshell colors",
        "",
        "pragma Singleton",
        "",
        "import QtQuick",
        "",
        "QtObject {",
        "",
        "  function colorChannel(color: string): string {",
        "    return color.startsWith(\"#\") ? color.slice(1) : color;",
        "  }",
        "",
        "  function alpha(percent: real): string {",
        "    const value = Math.max(0, Math.min(255, Math.round(255 * percent / 100)));",
        "    return value.toString(16).padStart(2, \"0\");",
        "  }",
        "",
        "  function withAlpha(color: string, opacity): string {",
        "    const value = typeof opacity === \"number\" ? alpha(opacity) : opacity;",
        "    return \"#\" + value + colorChannel(color);",
        "  }",
        "",
        "  function alphaColor(rgb: string, percent: real): string {",
        "    return withAlpha(rgb, percent);",
        "  }",
    ]

    lines.extend([
        "",
        "  // Canonical foreground roles.",
        f"  readonly property color foreground: \"{normalize(sources['foreground'])}\"",
        f"  readonly property color foregroundStrong: \"{normalize(sources['foregroundStrong'])}\"",
        f"  readonly property color foregroundMuted: \"{normalize(sources['foregroundMuted'])}\"",
        f"  readonly property color foregroundSubtle: \"{normalize(sources['foregroundSubtle'])}\"",
        "  readonly property color foregroundDisabled: withAlpha(foregroundMuted, 50)",
        f"  readonly property color foregroundInverted: \"{normalize(sources['foregroundInverted'])}\"",
        "",
        "  // Canonical accent roles.",
        f"  readonly property color accent: \"{normalize(sources['accent'])}\"",
        f"  readonly property color accentStrong: \"{normalize(sources['accentStrong'])}\"",
        f"  readonly property color foregroundOnAccent: \"{normalize(sources['onAccent'])}\"",
        "  readonly property color accentBackground: withAlpha(accent, 20)",
        "  readonly property color accentSelectedBackground: withAlpha(accent, 30)",
        "",
        "  // Canonical surface roles.",
        f"  readonly property color background: \"{normalize(sources['background'])}\"",
        f"  readonly property color surface: \"{normalize(sources['surface'])}\"",
        f"  readonly property color surfaceContainer: \"{normalize(sources['surfaceContainer'])}\"",
        f"  readonly property color surfaceCard: \"{normalize(sources['surfaceCard'])}\"",
        f"  readonly property color surfaceControl: \"{normalize(sources['surfaceControl'])}\"",
        f"  readonly property color surfaceSubtle: \"{normalize(sources['surfaceSubtle'])}\"",
        f"  readonly property color surfaceHover: \"{normalize(sources['surfaceHover'])}\"",
        f"  readonly property color surfacePressed: \"{normalize(sources['surfacePressed'])}\"",
        f"  readonly property color surfaceActive: \"{normalize(sources['surfaceActive'])}\"",
        f"  readonly property color surfaceSelected: \"{normalize(sources['surfaceSelected'])}\"",
        f"  readonly property color surfaceFloating: \"{normalize(sources['surfaceFloating'])}\"",
        f"  readonly property color surfaceFloatingStrong: \"{normalize(sources['surfaceFloatingStrong'])}\"",
        "",
        "  // Canonical border roles.",
        f"  readonly property color border: \"{normalize(sources['border'])}\"",
        f"  readonly property color borderMuted: \"{normalize(sources['borderMuted'])}\"",
        f"  readonly property color borderStrong: \"{normalize(sources['borderStrong'])}\"",
        f"  readonly property color borderFocus: \"{normalize(sources['borderFocus'])}\"",
        "",
        "  // Canonical status roles.",
        f"  readonly property color info: \"{normalize(sources['info'])}\"",
        f"  readonly property color success: \"{normalize(sources['success'])}\"",
        f"  readonly property color warning: \"{normalize(sources['warning'])}\"",
        f"  readonly property color danger: \"{normalize(sources['danger'])}\"",
        "  readonly property color infoBackground: withAlpha(info, 20)",
        "  readonly property color successBackground: withAlpha(success, 20)",
        "  readonly property color warningBackground: withAlpha(warning, 20)",
        "  readonly property color dangerBackground: withAlpha(danger, 20)",
        "",
        "  // Permanent icon foreground roles used by Config/Icons.qml tone mapping.",
        f"  readonly property color iconPrimary: \"{normalize(sources['iconPrimary'])}\"",
        f"  readonly property color iconSecondary: \"{normalize(sources['iconSecondary'])}\"",
        f"  readonly property color iconMuted: \"{normalize(sources['iconMuted'])}\"",
        f"  readonly property color iconSubtle: \"{normalize(sources['iconSubtle'])}\"",
        f"  readonly property color iconAccent: \"{normalize(sources['iconAccent'])}\"",
        f"  readonly property color iconOnAccent: \"{normalize(sources['iconOnAccent'])}\"",
        f"  readonly property color iconInverse: \"{normalize(sources['iconInverse'])}\"",
        f"  readonly property color iconBrand: \"{normalize(sources['iconBrand'])}\"",
        f"  readonly property color iconDisabled: withAlpha(\"{normalize(sources['iconDisabled'])}\", 50)",
        f"  readonly property color iconDanger: \"{normalize(sources['iconDanger'])}\"",
        "",
        "  // Shallow Kitana component roles. Keep these independently defined for future per-component tuning.",
        "  readonly property color barBackground: withAlpha(background, 92)",
        "  readonly property color barForeground: foreground",
        "  readonly property color barHoverBackground: withAlpha(surfaceHover, 93)",
        "  readonly property color barBorder: borderStrong",
        "",
        "  readonly property color panelBackground: withAlpha(background, 92)",
        "  readonly property color panelForeground: foreground",
        "  readonly property color panelBorder: border",
        "",
        "  readonly property color containerBackground: withAlpha(surfaceContainer, 85)",
        "  readonly property color containerForeground: foreground",
        "  readonly property color containerBorder: border",
        "",
        "  readonly property color cardBackground: withAlpha(surfaceCard, 68)",
        "  readonly property color cardForeground: foreground",
        "  readonly property color cardBorder: borderStrong",
        "",
        "  readonly property color controlBackground: withAlpha(surfaceControl, 80)",
        "  readonly property color controlForeground: foreground",
        "  readonly property color controlBorder: border",
        "  readonly property color controlSubtleBackground: surfaceSubtle",
        "  readonly property color controlHoverBackground: withAlpha(surfaceHover, 95)",
        "  readonly property color controlPressedBackground: withAlpha(surfacePressed, 96)",
        "  readonly property color controlActiveBackground: withAlpha(surfaceActive, 25)",
        "  readonly property color controlActiveForeground: foreground",
        "  readonly property color controlActiveBorder: borderFocus",
        "",
        "  readonly property color inputBackground: withAlpha(surfaceControl, 80)",
        "  readonly property color inputForeground: foreground",
        "  readonly property color inputPlaceholderForeground: foregroundMuted",
        "  readonly property color inputBorder: border",
        "  readonly property color inputActiveBorder: borderFocus",
        "",
        "  readonly property color workspaceInactiveBackground: surfaceCard",
        "  readonly property color workspaceInactiveForeground: foregroundMuted",
        "  readonly property color workspaceOccupiedBackground: withAlpha(surfaceSubtle, 90)",
        "  readonly property color workspaceOccupiedForeground: foreground",
        "  readonly property color workspaceActiveBackground: accent",
        "  readonly property color workspaceActiveForeground: foregroundOnAccent",
        "  readonly property color workspaceUrgentBackground: withAlpha(danger, 20)",
        "  readonly property color workspaceUrgentForeground: danger",
        "",
        "  // Overlays.",
        "  readonly property color scrim: withAlpha(background, 52)",
        "  readonly property color scrimSoft: withAlpha(background, 32)",
        "  readonly property color imageOverlay: withAlpha(background, 60)",
        f"  readonly property color shadow: withAlpha(\"{normalize(sources['shadow'])}\", 45)",
        "}",
    ])

    target_path.write_text("\n".join(lines) + "\n")

def sources_from_hex(color):
    color = normalize(color)
    r, g, b = (int(color[i:i + 2], 16) / 255 for i in (1, 3, 5))
    h, lightness, saturation = colorsys.rgb_to_hls(r, g, b)

    def hex_color(lightness, saturation_override=None):
        rr, gg, bb = colorsys.hls_to_rgb(h, lightness, saturation if saturation_override is None else saturation_override)
        return "#{:02x}{:02x}{:02x}".format(round(rr * 255), round(gg * 255), round(bb * 255))

    background = hex_color(0.10, max(saturation * 0.45, 0.12))
    surface = hex_color(0.16, max(saturation * 0.40, 0.10))
    surface_alt = hex_color(0.24, max(saturation * 0.40, 0.10))
    foreground = "#f4f4f5"
    muted = "#a1a1aa"

    return {
        "foreground": foreground,
        "foregroundStrong": "#ffffff",
        "foregroundMuted": muted,
        "foregroundSubtle": muted,
        "foregroundDisabled": muted,
        "foregroundInverted": background,
        "accent": color,
        "accentStrong": color,
        "onAccent": background,
        "accentBackground": color,
        "accentSelectedBackground": color,
        "background": background,
        "surface": background,
        "surfaceContainer": background,
        "surfaceCard": surface,
        "surfaceControl": surface,
        "surfaceSubtle": surface_alt,
        "surfaceHover": surface_alt,
        "surfacePressed": surface_alt,
        "surfaceActive": color,
        "surfaceSelected": color,
        "surfaceFloating": background,
        "surfaceFloatingStrong": surface,
        "border": surface,
        "borderMuted": surface,
        "borderStrong": surface_alt,
        "borderFocus": color,
        "info": color,
        "success": "#a6e3a1",
        "warning": "#f9e2af",
        "danger": "#f38ba8",
        "infoBackground": color,
        "successBackground": "#a6e3a1",
        "warningBackground": "#f9e2af",
        "dangerBackground": "#f38ba8",
        "iconPrimary": foreground,
        "iconSecondary": "#ffffff",
        "iconMuted": muted,
        "iconSubtle": muted,
        "iconAccent": color,
        "iconOnAccent": background,
        "iconInverse": background,
        "iconBrand": color,
        "iconDisabled": muted,
        "iconDanger": "#f38ba8",
        "scrim": surface,
        "scrimSoft": surface,
        "imageOverlay": surface,
        "shadow": "#000000",
    }

def sources_from_json(path):
    data = json.loads(pathlib.Path(path).read_text())
    colors = data.get("colors", data)

    def extract(candidate):
        if isinstance(candidate, str):
            return candidate
        if not isinstance(candidate, dict):
            return None
        for key in ("color", "hex"):
            if isinstance(candidate.get(key), str):
                return candidate[key]
        for mode_name in ("dark", "default", "light"):
            extracted = extract(candidate.get(mode_name))
            if extracted:
                return extracted
        return None

    def get(name, fallback):
        value = colors.get(name)
        if value is None and isinstance(colors.get("dark"), dict):
            value = colors["dark"].get(name)
        return normalize(extract(value) or fallback)

    background = get("background", "#1e1e2e")
    surface = get("surface_container", "#313244")
    surface_alt = get("surface_container_high", "#45475a")
    surface_hover = get("surface_container_highest", surface_alt)
    accent = get("primary", "#89b4fa")
    accent_strong = get("primary_container", accent)
    foreground = get("on_background", "#cdd6f4")
    muted = get("on_surface_variant", "#9399b2")
    on_accent = get("on_primary", background)
    warning = get("tertiary", "#f9e2af")
    danger = get("error", "#f38ba8")
    success = get("secondary", "#a6e3a1")
    outline = get("outline", muted)
    outline_variant = get("outline_variant", surface_alt)
    workspace_inactive = get("surface_container", surface)
    workspace_occupied = get("secondary_container", surface_alt)

    return {
        "foreground": foreground,
        "foregroundStrong": foreground,
        "foregroundMuted": muted,
        "foregroundSubtle": outline,
        "foregroundDisabled": muted,
        "foregroundInverted": on_accent,
        "accent": accent,
        "accentStrong": accent_strong,
        "onAccent": on_accent,
        "accentBackground": accent,
        "accentSelectedBackground": accent,
        "background": background,
        "surface": background,
        "surfaceContainer": on_accent,
        "surfaceCard": surface,
        "surfaceControl": surface,
        "surfaceSubtle": surface_alt,
        "surfaceHover": surface_hover,
        "surfacePressed": surface_hover,
        "surfaceActive": accent,
        "surfaceSelected": accent,
        "surfaceFloating": background,
        "surfaceFloatingStrong": surface,
        "border": outline_variant,
        "borderMuted": outline_variant,
        "borderStrong": outline,
        "borderFocus": accent,
        "info": accent,
        "success": success,
        "warning": warning,
        "danger": danger,
        "infoBackground": accent,
        "successBackground": success,
        "warningBackground": warning,
        "dangerBackground": danger,
        "iconPrimary": foreground,
        "iconSecondary": foreground,
        "iconMuted": muted,
        "iconSubtle": outline,
        "iconAccent": accent,
        "iconOnAccent": on_accent,
        "iconInverse": on_accent,
        "iconBrand": accent,
        "iconDisabled": muted,
        "iconDanger": danger,
        "scrim": background,
        "scrimSoft": background,
        "imageOverlay": background,
        "shadow": "#000000",
    }

write_qml(sources_from_hex(source) if mode == "hex" else sources_from_json(source))
PY
}

average_color() {
  if command -v magick >/dev/null 2>&1; then
    magick "$source_value" -resize 1x1! -format '#%[hex:p{0,0}]' info:
  elif command -v convert >/dev/null 2>&1; then
    convert "$source_value" -resize 1x1! -format '#%[hex:p{0,0}]' info:
  else
    return 1
  fi
}

if [[ "$source_value" =~ ^#?[0-9a-fA-F]{6}$ ]]; then
  generate_colors hex "#${source_value#\#}"
  finish "Generated $target from #${source_value#\#}"
fi

if [ ! -f "$source_value" ]; then
  echo "wallpaper not found: $source_value"
  exit 1
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

if command -v matugen >/dev/null 2>&1 && matugen image "$source_value" --dry-run --source-color-index 0 --json hex >"$tmpdir/colors.json" 2>"$tmpdir/matugen.err"; then
  generate_colors json "$tmpdir/colors.json"
  finish "Generated $target from $source_value"
fi

if color="$(average_color)"; then
  generate_colors hex "$color"
  finish "Generated $target from average wallpaper color $color"
fi

echo "Could not extract colors from wallpaper: $source_value"
echo "Install matugen or ImageMagick, or pass a hex color like '#89b4fa'."
exit 1
