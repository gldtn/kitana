#!/bin/bash

set -euo pipefail

source_value="${1:-$HOME/.config/kitana/current-wallpaper}"
kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
lua_path="$kitana_dir/lib/?.lua;$kitana_dir/lib/?/init.lua;;"
target="$HOME/.config/quickshell/kitana/Theme/current.json"
state_dir="$HOME/.config/kitana"
state_file="$state_dir/theme"
legacy_target="$HOME/.config/quickshell/kitana/Colors.qml"

mkdir -p "$(dirname "$target")" "$state_dir"

remove_legacy_target() {
  if [ -f "$legacy_target" ] && grep -q "Kitana managed Quickshell colors" "$legacy_target"; then
    rm "$legacy_target"
  fi
}

write_theme() {
  local mode="$1"
  local source="$2"
  local tmp

  tmp="$(mktemp "$target.tmp.XXXXXX")"
  LUA_PATH="$lua_path" lua - "$mode" "$source" >"$tmp" <<'LUA'
local json = require("kitana-json")

local mode, source = arg[1], arg[2]

local function read_file(path)
  local file = assert(io.open(path, "rb"))
  local data = file:read("*a")
  file:close()
  return data
end

local function normalize(color)
  color = tostring(color or ""):match("^%s*(.-)%s*$")
  if #color == 8 and not color:match("^#") then
    color = color:sub(3)
  elseif #color == 9 and color:match("^#") then
    color = "#" .. color:sub(4)
  end
  return "#" .. color:gsub("^#", "")
end

local function extract(candidate)
  if type(candidate) == "string" then
    return candidate
  end
  if type(candidate) ~= "table" then
    return nil
  end
  if type(candidate.color) == "string" then
    return candidate.color
  end
  if type(candidate.hex) == "string" then
    return candidate.hex
  end
  for _, mode_name in ipairs({ "dark", "default", "light" }) do
    local extracted = extract(candidate[mode_name])
    if extracted then
      return extracted
    end
  end
  return nil
end

local function material_theme(path)
  local data = json.decode(read_file(path))
  local colors = data.colors or data

  local function get(name, fallback)
    local value = colors[name]
    if value == nil and type(colors.dark) == "table" then
      value = colors.dark[name]
    end
    return normalize(extract(value) or fallback)
  end

  return {
    source_color = get("source_color", "#89b4fa"),
    primary = get("primary", "#89b4fa"),
    on_primary = get("on_primary", "#11111b"),
    primary_container = get("primary_container", "#313244"),
    on_primary_container = get("on_primary_container", "#cdd6f4"),
    secondary = get("secondary", "#a6e3a1"),
    on_secondary = get("on_secondary", "#11111b"),
    tertiary = get("tertiary", "#f9e2af"),
    on_tertiary = get("on_tertiary", "#11111b"),
    surface = get("surface", "#1e1e2e"),
    surface_container_low = get("surface_container_low", "#181825"),
    surface_container = get("surface_container", "#313244"),
    surface_container_high = get("surface_container_high", "#45475a"),
    surface_container_highest = get("surface_container_highest", "#585b70"),
    on_surface = get("on_surface", "#cdd6f4"),
    on_surface_variant = get("on_surface_variant", "#9399b2"),
    outline = get("outline", "#6c7086"),
    outline_variant = get("outline_variant", "#313244"),
    inverse_surface = get("inverse_surface", "#cdd6f4"),
    inverse_on_surface = get("inverse_on_surface", "#11111b"),
    error = get("error", "#f38ba8"),
    on_error = get("on_error", "#11111b"),
  }
end

local function hue_to_rgb(p, q, t)
  if t < 0 then
    t = t + 1
  elseif t > 1 then
    t = t - 1
  end
  if t < 1 / 6 then
    return p + (q - p) * 6 * t
  elseif t < 1 / 2 then
    return q
  elseif t < 2 / 3 then
    return p + (q - p) * (2 / 3 - t) * 6
  end
  return p
end

local function rgb_to_hsl(r, g, b)
  local max_value = math.max(r, g, b)
  local min_value = math.min(r, g, b)
  local lightness = (max_value + min_value) / 2

  if max_value == min_value then
    return 0, lightness, 0
  end

  local delta = max_value - min_value
  local saturation = lightness > 0.5 and delta / (2 - max_value - min_value) or delta / (max_value + min_value)
  local hue
  if max_value == r then
    hue = (g - b) / delta + (g < b and 6 or 0)
  elseif max_value == g then
    hue = (b - r) / delta + 2
  else
    hue = (r - g) / delta + 4
  end

  return hue / 6, lightness, saturation
end

local function hsl_to_rgb(hue, lightness, saturation)
  if saturation == 0 then
    return lightness, lightness, lightness
  end

  local q = lightness < 0.5 and lightness * (1 + saturation) or lightness + saturation - lightness * saturation
  local p = 2 * lightness - q
  return hue_to_rgb(p, q, hue + 1 / 3), hue_to_rgb(p, q, hue), hue_to_rgb(p, q, hue - 1 / 3)
end

local function hsl_theme(color)
  color = normalize(color)
  local r = tonumber(color:sub(2, 3), 16) / 255
  local g = tonumber(color:sub(4, 5), 16) / 255
  local b = tonumber(color:sub(6, 7), 16) / 255
  local hue, _, saturation = rgb_to_hsl(r, g, b)

  local function hex_color(lightness, saturation_override)
    local rr, gg, bb = hsl_to_rgb(hue, lightness, saturation_override or saturation)
    return string.format("#%02x%02x%02x", math.floor(rr * 255 + 0.5), math.floor(gg * 255 + 0.5), math.floor(bb * 255 + 0.5))
  end

  local background = hex_color(0.10, math.max(saturation * 0.45, 0.12))
  local surface = hex_color(0.16, math.max(saturation * 0.40, 0.10))
  local surface_high = hex_color(0.24, math.max(saturation * 0.40, 0.10))

  return {
    source_color = color,
    primary = color,
    on_primary = background,
    primary_container = surface_high,
    on_primary_container = "#f4f4f5",
    secondary = "#a6e3a1",
    on_secondary = background,
    tertiary = "#f9e2af",
    on_tertiary = background,
    surface = background,
    surface_container_low = background,
    surface_container = surface,
    surface_container_high = surface_high,
    surface_container_highest = surface_high,
    on_surface = "#f4f4f5",
    on_surface_variant = "#a1a1aa",
    outline = "#a1a1aa",
    outline_variant = surface_high,
    inverse_surface = "#f4f4f5",
    inverse_on_surface = background,
    error = "#f38ba8",
    on_error = background,
  }
end

local colors = mode == "hex" and hsl_theme(source) or material_theme(source)

local theme = {
  slug = "matugen",
  name = "Matugen",
  mode = "dark",
  colors = colors,
  palette = {
    fgPrimary = "on_surface",
    fgSecondary = "on_surface_variant",
    fgTertiary = "outline",
    fgOnPrimary = "on_primary",
    fgAccent = "primary",
    bgPrimary = "surface",
    bgSecondary = "surface_container",
    bgTertiary = "surface_container_high",
    bgOnPrimary = "on_primary",
    bgAccent = "primary",
    borderDark = "outline",
    borderLight = "outline_variant",
    borderFaint = "outline_variant",
    borderHeavy = "on_surface_variant",
    borderAccent = "primary",
    info = "primary",
    success = "secondary",
    warning = "tertiary",
    error = "error",
    scrimPrimary = { ref = "surface", alpha = 0.52 },
    scrimSecondary = { ref = "surface", alpha = 0.32 },
    scrimTertiary = { ref = "surface", alpha = 0.60 },
    subtlePrimary = { ref = "primary", alpha = 0.16 },
    subtleSecondary = { ref = "surface_container_highest", alpha = 0.65 },
    subtleTertiary = { ref = "outline", alpha = 0.50 },
  },
  icons = {
    primary = "fgPrimary",
    secondary = "fgSecondary",
    muted = "fgTertiary",
    subtle = "fgTertiary",
    accent = "fgAccent",
    onAccent = "fgOnPrimary",
    inverse = "bgOnPrimary",
    brand = "fgAccent",
    disabled = { ref = "fgTertiary", alpha = 0.5 },
    danger = "error",
  },
}

io.write(json.encode(theme, { indent = "  " }), "\n")
LUA
  mv "$tmp" "$target"
  printf 'matugen\n' >"$state_file"
  remove_legacy_target
}

average_color() {
  if command -v magick >/dev/null 2>&1; then
    magick "$source_value" -resize 1x1! -format '#%[hex:p{0,0}]' info:
  elif command -v convert >/dev/null 2>&1; then
    convert "$source_value" -resize 1x1! -format '#%[hex:p{0,0}]' info:
  else
    return 1
  fi
}

if [[ "$source_value" =~ ^#?[0-9a-fA-F]{6}$ ]]; then
  write_theme hex "#${source_value#\#}"
  echo "Generated $target from #${source_value#\#}"
  exit 0
fi

if [ ! -f "$source_value" ]; then
  echo "wallpaper not found: $source_value"
  exit 1
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

if command -v matugen >/dev/null 2>&1 && matugen image "$source_value" --dry-run --source-color-index 0 --json hex >"$tmpdir/colors.json" 2>"$tmpdir/matugen.err"; then
  write_theme json "$tmpdir/colors.json"
  echo "Generated $target from $source_value"
  exit 0
fi

if color="$(average_color)"; then
  write_theme hex "$color"
  echo "Generated $target from average wallpaper color $color"
  exit 0
fi

echo "Could not extract colors from wallpaper: $source_value"
echo "Install matugen or ImageMagick, or pass a hex color like '#89b4fa'."
exit 1
