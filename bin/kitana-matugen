#!/bin/bash

set -euo pipefail

source_value="${1:-$HOME/.config/kitana/current-wallpaper}"
target="$HOME/.config/quickshell/kitana/Colors.qml"
mkdir -p "$(dirname "$target")"

generate_from_hex() {
  local color="#${1#\#}"

  python - "$color" "$target" <<'PY'
import colorsys
import pathlib
import sys

source = sys.argv[1]
target = pathlib.Path(sys.argv[2])

r, g, b = (int(source[i:i + 2], 16) / 255 for i in (1, 3, 5))
h, l, s = colorsys.rgb_to_hls(r, g, b)

def hex_color(lightness, saturation=None):
    rr, gg, bb = colorsys.hls_to_rgb(h, lightness, s if saturation is None else saturation)
    return "#{:02x}{:02x}{:02x}".format(round(rr * 255), round(gg * 255), round(bb * 255))

def alpha(color, opacity):
    return "#{:02x}{}".format(round(opacity * 255), color.lstrip("#"))

background = hex_color(0.10, max(s * 0.45, 0.12))
surface = hex_color(0.16, max(s * 0.40, 0.10))
surface_alt = hex_color(0.24, max(s * 0.40, 0.10))
background_rgb = background.lstrip("#")
surface_rgb = surface.lstrip("#")
surface_alt_rgb = surface_alt.lstrip("#")
source_rgb = source.lstrip("#")

target.write_text(f'''// Kitana managed Quickshell colors

pragma Singleton

import QtQuick

QtObject {{
  // Alpha reference:
  // 98% = fa
  // 96% = f5
  // 90% = e6
  // 86% = db
  // 80% = cc
  // 76% = c2
  // 70% = b3
  // 66% = a8
  // 60% = 99
  // 45% = 73

  function withAlpha(rgb: string, alpha: string): string {{
    return "#" + alpha + rgb;
  }}

  // Raw palette. Suffix 0 is darker, suffix 1 is lighter.
  readonly property string crust0: "{background_rgb}"
  readonly property string crust1: "{surface_rgb}"
  readonly property string mantle0: "{background_rgb}"
  readonly property string mantle1: "{surface_rgb}"
  readonly property string base0: "{background_rgb}"
  readonly property string base1: "{surface_rgb}"
  readonly property string surface0: "{surface_rgb}"
  readonly property string surface1: "{surface_alt_rgb}"
  readonly property string overlay0: "{surface_alt_rgb}"
  readonly property string overlay1: "a1a1aa"
  readonly property string subtext0: "a1a1aa"
  readonly property string subtext1: "f4f4f5"
  readonly property string text0: "f4f4f5"
  readonly property string text1: "ffffff"
  readonly property string accent0: "{source_rgb}"
  readonly property string accent1: "{source_rgb}"
  readonly property string warning0: "f9e2af"
  readonly property string danger0: "f38ba8"

  // Alpha presets for blur-friendly panel layers.
  readonly property string panelAlpha: "fa"
  readonly property string panelContainerAlpha: "73"
  readonly property string panelCardAlpha: "99"
  readonly property string panelButtonAlpha: "cc"
  readonly property string panelInputAlpha: "cc"
  readonly property string scrimAlpha: "85"
  readonly property string scrimSoftAlpha: "52"
  readonly property string imageOverlayAlpha: "99"

  // Semantic foreground and background roles.
  readonly property color accentForeground: "#" + accent0
  readonly property color primaryForeground: "#" + text0
  readonly property color secondaryForeground: "#" + text1
  readonly property color mutedForeground: "#" + subtext0
  readonly property color accentBackground: "#33" + accent0
  readonly property color primaryBackground: "#" + base0
  readonly property color secondaryBackground: "#" + mantle0
  readonly property color mutedBackground: "#" + crust0

  // Outer dashboard/system/wallpaper picker shell.
  readonly property color panelBackground: withAlpha(base0, panelAlpha)
  readonly property color panelForeground: primaryForeground
  readonly property color panelBorder: "#9e" + surface0

  // Sidebar/calendar/content sections inside larger panels.
  readonly property color panelContainerBackground: withAlpha(crust0, panelContainerAlpha)
  readonly property color panelContainerForeground: primaryForeground
  readonly property color panelContainerBorder: "#40" + mantle1

  // Repeated cards such as media cards, theme cards, and wallpaper cards.
  readonly property color panelCardBackground: withAlpha(base1, panelCardAlpha)
  readonly property color panelCardForeground: primaryForeground
  readonly property color panelCardBorder: "#9e" + surface1

  // Buttons, tabs, pills, and calendar day cells.
  readonly property color panelButtonBackground: withAlpha(surface0, panelButtonAlpha)
  readonly property color panelButtonBackgroundHover: "#ee" + surface1
  readonly property color panelButtonBackgroundActive: accentBackground
  readonly property color panelButtonForeground: primaryForeground
  readonly property color panelButtonBorder: panelBorder
  readonly property color panelButtonBorderActive: "#b8" + accent0

  // Text inputs and search fields.
  readonly property color panelInputBackground: withAlpha(surface0, panelInputAlpha)
  readonly property color panelInputForeground: primaryForeground
  readonly property color panelInputBorder: panelBorder
  readonly property color panelInputBorderActive: panelButtonBorderActive

  // Status colors.
  readonly property color warningForeground: "#" + warning0
  readonly property color dangerForeground: "#" + danger0
  readonly property color warningBackground: "#33" + warning0
  readonly property color dangerBackground: "#33" + danger0

  // Overlays.
  readonly property color scrim: withAlpha(crust1, scrimAlpha)
  readonly property color scrimSoft: withAlpha(crust1, scrimSoftAlpha)
  readonly property color imageOverlay: withAlpha(crust1, imageOverlayAlpha)

  // Temporary legacy aliases. Remove after all Kitana/custom QML uses component tokens.
  readonly property color background: "#" + base0
  readonly property color surface: panelCardBackground
  readonly property color surfaceAlt: "#" + surface1
  readonly property color surfaceHover: panelButtonBackgroundHover
  readonly property color surfaceHighlight: panelButtonBackgroundActive
  readonly property color panelBorderStrong: panelButtonBorderActive
  readonly property color workspaceInactive: "#c2" + surface0
  readonly property color workspaceOccupied: "#e6" + surface1
  readonly property color foreground: primaryForeground
  readonly property color muted: mutedForeground
  readonly property color accent: accentForeground
  readonly property color accentText: "#" + crust0
  readonly property color warning: warningForeground
  readonly property color danger: dangerForeground
}}
''')
PY
}

generate_from_json() {
  python - "$1" "$target" <<'PY'
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text())
colors = data.get("colors", data)

def get(name, fallback):
    value = colors.get(name)

    if value is None and isinstance(colors.get("dark"), dict):
        value = colors["dark"].get(name)

    def extract(candidate):
        if isinstance(candidate, str):
            return candidate
        if not isinstance(candidate, dict):
            return None

        for key in ("color", "hex"):
            if isinstance(candidate.get(key), str):
                return candidate[key]

        for mode in ("dark", "default", "light"):
            extracted = extract(candidate.get(mode))
            if extracted:
                return extracted

        return None

    return extract(value) or fallback

def alpha(color, opacity):
    color = color.lstrip("#")
    if len(color) == 8:
        color = color[2:]
    return "#{:02x}{}".format(round(opacity * 255), color)

background = get("background", "#1e1e2e")
surface = get("surface_container", "#313244")
surface_alt = get("surface_container_high", "#45475a")
surface_hover = get("surface_container_highest", surface_alt)
surface_highlight = get("primary_container", get("primary", "#89b4fa"))
workspace_inactive = get("surface_container", surface)
workspace_occupied = get("secondary_container", get("surface_container_high", surface_alt))
outline = get("outline", "#7f849c")
outline_variant = get("outline_variant", surface_alt)
background_rgb = background.lstrip("#")
surface_rgb = surface.lstrip("#")
surface_alt_rgb = surface_alt.lstrip("#")
surface_hover_rgb = surface_hover.lstrip("#")
surface_highlight_rgb = surface_highlight.lstrip("#")
workspace_inactive_rgb = workspace_inactive.lstrip("#")
workspace_occupied_rgb = workspace_occupied.lstrip("#")
outline_rgb = outline.lstrip("#")
outline_variant_rgb = outline_variant.lstrip("#")
foreground_rgb = get("on_background", "#cdd6f4").lstrip("#")
muted_rgb = get("on_surface_variant", "#9399b2").lstrip("#")
accent_rgb = get("primary", "#89b4fa").lstrip("#")
accent_text_rgb = get("on_primary", "#11111b").lstrip("#")
warning_rgb = get("tertiary", "#f9e2af").lstrip("#")
danger_rgb = get("error", "#f38ba8").lstrip("#")

pathlib.Path(sys.argv[2]).write_text(f'''// Kitana managed Quickshell colors

pragma Singleton

import QtQuick

QtObject {{
  // Alpha reference:
  // 98% = fa
  // 96% = f5
  // 90% = e6
  // 86% = db
  // 80% = cc
  // 76% = c2
  // 70% = b3
  // 66% = a8
  // 60% = 99
  // 45% = 73

  function withAlpha(rgb: string, alpha: string): string {{
    return "#" + alpha + rgb;
  }}

  // Raw palette. Suffix 0 is darker, suffix 1 is lighter.
  readonly property string crust0: "{accent_text_rgb}"
  readonly property string crust1: "{background_rgb}"
  readonly property string mantle0: "{background_rgb}"
  readonly property string mantle1: "{surface_rgb}"
  readonly property string base0: "{background_rgb}"
  readonly property string base1: "{surface_rgb}"
  readonly property string surface0: "{surface_rgb}"
  readonly property string surface1: "{surface_alt_rgb}"
  readonly property string overlay0: "{outline_variant_rgb}"
  readonly property string overlay1: "{outline_rgb}"
  readonly property string subtext0: "{muted_rgb}"
  readonly property string subtext1: "{foreground_rgb}"
  readonly property string text0: "{foreground_rgb}"
  readonly property string text1: "ffffff"
  readonly property string accent0: "{accent_rgb}"
  readonly property string accent1: "{surface_highlight_rgb}"
  readonly property string warning0: "{warning_rgb}"
  readonly property string danger0: "{danger_rgb}"

  // Alpha presets for blur-friendly panel layers.
  readonly property string panelAlpha: "fa"
  readonly property string panelContainerAlpha: "73"
  readonly property string panelCardAlpha: "99"
  readonly property string panelButtonAlpha: "cc"
  readonly property string panelInputAlpha: "cc"
  readonly property string scrimAlpha: "85"
  readonly property string scrimSoftAlpha: "52"
  readonly property string imageOverlayAlpha: "99"

  // Semantic foreground and background roles.
  readonly property color accentForeground: "#" + accent0
  readonly property color primaryForeground: "#" + text0
  readonly property color secondaryForeground: "#" + text1
  readonly property color mutedForeground: "#" + subtext0
  readonly property color accentBackground: "#33" + accent0
  readonly property color primaryBackground: "#" + base0
  readonly property color secondaryBackground: "#" + mantle0
  readonly property color mutedBackground: "#" + crust0

  // Outer dashboard/system/wallpaper picker shell.
  readonly property color panelBackground: withAlpha(base0, panelAlpha)
  readonly property color panelForeground: primaryForeground
  readonly property color panelBorder: "#9e" + surface0

  // Sidebar/calendar/content sections inside larger panels.
  readonly property color panelContainerBackground: withAlpha(crust0, panelContainerAlpha)
  readonly property color panelContainerForeground: primaryForeground
  readonly property color panelContainerBorder: "#40" + mantle1

  // Repeated cards such as media cards, theme cards, and wallpaper cards.
  readonly property color panelCardBackground: withAlpha(base1, panelCardAlpha)
  readonly property color panelCardForeground: primaryForeground
  readonly property color panelCardBorder: "#9e" + surface1

  // Buttons, tabs, pills, and calendar day cells.
  readonly property color panelButtonBackground: withAlpha(surface0, panelButtonAlpha)
  readonly property color panelButtonBackgroundHover: "#ee" + surface1
  readonly property color panelButtonBackgroundActive: accentBackground
  readonly property color panelButtonForeground: primaryForeground
  readonly property color panelButtonBorder: panelBorder
  readonly property color panelButtonBorderActive: "#b8" + accent0

  // Text inputs and search fields.
  readonly property color panelInputBackground: withAlpha(surface0, panelInputAlpha)
  readonly property color panelInputForeground: primaryForeground
  readonly property color panelInputBorder: panelBorder
  readonly property color panelInputBorderActive: panelButtonBorderActive

  // Status colors.
  readonly property color warningForeground: "#" + warning0
  readonly property color dangerForeground: "#" + danger0
  readonly property color warningBackground: "#33" + warning0
  readonly property color dangerBackground: "#33" + danger0

  // Overlays.
  readonly property color scrim: withAlpha(crust1, scrimAlpha)
  readonly property color scrimSoft: withAlpha(crust1, scrimSoftAlpha)
  readonly property color imageOverlay: withAlpha(crust1, imageOverlayAlpha)

  // Temporary legacy aliases. Remove after all Kitana/custom QML uses component tokens.
  readonly property color background: "#" + base0
  readonly property color surface: panelCardBackground
  readonly property color surfaceAlt: "#" + surface1
  readonly property color surfaceHover: panelButtonBackgroundHover
  readonly property color surfaceHighlight: panelButtonBackgroundActive
  readonly property color panelBorderStrong: panelButtonBorderActive
  readonly property color workspaceInactive: "#c2{workspace_inactive_rgb}"
  readonly property color workspaceOccupied: "#e6{workspace_occupied_rgb}"
  readonly property color foreground: primaryForeground
  readonly property color muted: mutedForeground
  readonly property color accent: accentForeground
  readonly property color accentText: "#" + crust0
  readonly property color warning: warningForeground
  readonly property color danger: dangerForeground
}}
''')
PY
}

average_color() {
  if command -v magick >/dev/null 2>&1; then
    magick "$source_value" -resize 1x1! -format '#%[hex:p{0,0}]' info:
  elif command -v convert >/dev/null 2>&1; then
    convert "$source_value" -resize 1x1! -format '#%[hex:p{0,0}]' info:
  else
    return 1
  fi
}

if [[ "$source_value" =~ ^#?[0-9a-fA-F]{6}$ ]]; then
  generate_from_hex "$source_value"
  echo "Generated $target from #${source_value#\#}"
  exit 0
fi

if [ ! -f "$source_value" ]; then
  echo "wallpaper not found: $source_value"
  exit 1
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

if command -v matugen >/dev/null 2>&1 && matugen image "$source_value" --dry-run --source-color-index 0 --json hex >"$tmpdir/colors.json" 2>"$tmpdir/matugen.err"; then
  generate_from_json "$tmpdir/colors.json"
  echo "Generated $target from $source_value"
  exit 0
fi

if color="$(average_color)"; then
  generate_from_hex "$color"
  echo "Generated $target from average wallpaper color $color"
  exit 0
fi

echo "Could not extract colors from wallpaper: $source_value"
echo "Install matugen or ImageMagick, or pass a hex color like '#89b4fa'."
exit 1
