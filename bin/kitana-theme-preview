#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
log_file="/tmp/kitana-theme-preview.log"
action="${1:-toggle}"

case "$action" in
  --open) action="open" ;;
  --close) action="close" ;;
  --toggle) action="toggle" ;;
esac

case "$action" in
  open|close|toggle) ;;
  -h|--help|help)
    printf 'Usage: kitana-theme-preview [open|close|toggle]\n'
    exit 0
    ;;
  *)
    printf 'Usage: kitana-theme-preview [open|close|toggle]\n' >&2
    exit 2
    ;;
esac

if ! command -v quickshell >/dev/null 2>&1; then
  command -v notify-send >/dev/null 2>&1 && notify-send "Kitana" "Quickshell is not installed"
  exit 1
fi

if ! pgrep -x quickshell >/dev/null 2>&1; then
  "$kitana_dir/bin/kitana-quickshell" >/dev/null 2>&1 || true
  sleep 0.5
fi

if quickshell ipc -c kitana call kitana-theme-preview "$action" >"$log_file" 2>&1; then
  exit 0
fi

command -v notify-send >/dev/null 2>&1 && notify-send "Kitana" "Theme preview is not available. Try reloading Quickshell."
exit 1
