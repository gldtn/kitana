#!/bin/bash

set -euo pipefail

KITANA_DIR="${KITANA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PATH="$KITANA_DIR/bin:$PATH"

sddm_dry_run=0
sddm_test_mode=0
targets=()

usage() {
  cat <<EOF
Usage: kitana-refresh [--applications] [--configs] [--sddm] [--wallpapers] [--dry-run] [--test-mode]

Refresh generated or deployed Kitana files.

Targets:
  --applications  Refresh desktop entries and web app launchers
  --configs       Refresh Kitana-managed user configs
  --sddm          Refresh Kitana SDDM theme and greeter config
  --wallpapers    Refresh optional wallpaper extras

SDDM options:
  --dry-run       Print SDDM actions without changing system files
  --test-mode     Launch sddm-greeter test mode after refreshing SDDM
EOF
}

add_target() {
  local target="$1"
  local existing

  for existing in "${targets[@]}"; do
    [ "$existing" = "$target" ] && return 0
  done

  targets+=("$target")
}

refresh_applications() {
  mkdir -p "$HOME/.local/share/applications"

  if [ -d "$KITANA_DIR/applications/hidden" ]; then
    cp "$KITANA_DIR"/applications/hidden/*.desktop "$HOME/.local/share/applications/"
  fi

  bash "$KITANA_DIR/install/apps/webapps.sh"

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$HOME/.local/share/applications" || true
  fi
}

refresh_configs() {
  bash "$KITANA_DIR/install/desktop/configs.sh"
}

refresh_wallpapers() {
  kitana-install-extras-wallpapers
}

run_sddm() {
  if [ "$sddm_dry_run" -eq 1 ]; then
    printf '+'
    local arg
    for arg in "$@"; do
      printf ' %q' "$arg"
    done
    printf '\n'
  else
    "$@"
  fi
}

write_sddm_wayland_conf() {
  local wayland_conf="$1"

  if [ "$sddm_dry_run" -eq 1 ]; then
    printf '+ write %s\n' "$wayland_conf"
    return
  fi

  sudo tee "$wayland_conf" >/dev/null <<EOF
[General]
DisplayServer=wayland

[Wayland]
CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.lua
EOF
}

write_sddm_theme_conf() {
  local theme_conf="$1"

  if [ "$sddm_dry_run" -eq 1 ]; then
    printf '+ write %s\n' "$theme_conf"
    return
  fi

  sudo tee "$theme_conf" >/dev/null <<EOF
[Theme]
Current=kitana
EOF
}

remove_old_sddm_dropins() {
  run_sddm sudo rm -f /usr/share/sddm/hyprland.conf /etc/kitana/sddm-hyprland.conf

  if [ -f /etc/sddm.conf.d/20-hyprland.conf ] && grep -q '/etc/kitana/sddm-hyprland.conf' /etc/sddm.conf.d/20-hyprland.conf; then
    run_sddm sudo rm -f /etc/sddm.conf.d/20-hyprland.conf
  fi

  if [ -f /etc/sddm.conf.d/10-theme.conf ] && grep -q '^Current=pixie$' /etc/sddm.conf.d/10-theme.conf; then
    run_sddm sudo rm -f /etc/sddm.conf.d/10-theme.conf
  fi
}

refresh_sddm() {
  local source_theme="$KITANA_DIR/default/sddm/theme"
  local target_theme="/usr/share/sddm/themes/kitana"
  local target_hyprland="/usr/share/sddm/hyprland.lua"
  local wayland_conf="/etc/sddm.conf.d/10-wayland.conf"
  local theme_conf="/etc/sddm.conf.d/20-theme.conf"
  local default_background="$KITANA_DIR/default/wallpapers/kitana-wallpaper-001.jpg"

  if [ ! -f "$KITANA_DIR/default/sddm/hyprland.lua" ]; then
    echo "Missing SDDM Hyprland config: $KITANA_DIR/default/sddm/hyprland.lua" >&2
    exit 1
  fi

  if [ ! -d "$source_theme" ]; then
    echo "Missing SDDM theme source: $source_theme" >&2
    exit 1
  fi

  run_sddm sudo mkdir -p /usr/share/sddm /usr/share/sddm/themes /etc/sddm.conf.d
  run_sddm sudo cp "$KITANA_DIR/default/sddm/hyprland.lua" "$target_hyprland"
  remove_old_sddm_dropins
  run_sddm sudo rm -rf "$target_theme"
  run_sddm sudo cp -r "$source_theme" "$target_theme"

  if [ -e "$HOME/.config/kitana/current-wallpaper" ]; then
    run_sddm sudo cp -L "$HOME/.config/kitana/current-wallpaper" "$target_theme/background"
  elif [ -f "$default_background" ]; then
    run_sddm sudo cp "$default_background" "$target_theme/background"
  fi

  write_sddm_wayland_conf "$wayland_conf"
  write_sddm_theme_conf "$theme_conf"

  echo "Kitana SDDM theme refreshed."
  echo "Test with: sddm-greeter --test-mode --theme $target_theme"

  if [ "$sddm_test_mode" -eq 1 ]; then
    if [ "$sddm_dry_run" -eq 1 ]; then
      echo "+ sddm-greeter --test-mode --theme $target_theme"
    else
      sddm-greeter --test-mode --theme "$target_theme"
    fi
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --applications)
      add_target applications
      ;;
    --configs)
      add_target configs
      ;;
    --sddm)
      add_target sddm
      ;;
    --wallpapers)
      add_target wallpapers
      ;;
    --dry-run)
      sddm_dry_run=1
      ;;
    --test-mode)
      sddm_test_mode=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [ "${#targets[@]}" -eq 0 ]; then
  usage >&2
  exit 2
fi

for target in "${targets[@]}"; do
  case "$target" in
    applications) refresh_applications ;;
    configs) refresh_configs ;;
    sddm) refresh_sddm ;;
    wallpapers) refresh_wallpapers ;;
  esac
done
