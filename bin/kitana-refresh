#!/bin/bash

set -euo pipefail

KITANA_DIR="${KITANA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PATH="$KITANA_DIR/bin:$PATH"
KITANA_HIDDEN_APPLICATIONS_DIR="$KITANA_DIR/applications/hidden"
USER_HIDDEN_APPLICATIONS_DIR="$HOME/.config/kitana/applications/hidden"

sddm_dry_run=0
sddm_test_mode=0
targets=()

usage() {
  cat <<EOF
Usage: kitana-refresh [--applications] [--configs] [--sddm] [--wallpapers] [--dry-run] [--test-mode]

Refresh generated or deployed Kitana files.

Targets:
  --applications  Refresh desktop entries and web app launchers
  --configs       Refresh Kitana-managed user configs
  --sddm          Refresh Kitana SDDM theme and greeter config
  --wallpapers    Refresh optional wallpaper extras

SDDM options:
  --dry-run       Print SDDM actions without changing system files
  --test-mode     Launch sddm-greeter test mode after refreshing SDDM
EOF
}

add_target() {
  local target="$1"
  local existing

  for existing in "${targets[@]}"; do
    [ "$existing" = "$target" ] && return 0
  done

  targets+=("$target")
}

desktop_entry_hides() {
  grep -Eiq '^[[:space:]]*(NoDisplay|Hidden)[[:space:]]*=[[:space:]]*true[[:space:]]*$' "$1"
}

hidden_desktop_source() {
  local desktop_id="$1"
  local user_file="$USER_HIDDEN_APPLICATIONS_DIR/$desktop_id"
  local kitana_file="$KITANA_HIDDEN_APPLICATIONS_DIR/$desktop_id"

  if [ -f "$user_file" ]; then
    printf '%s\n' "$user_file"
  elif [ -f "$kitana_file" ]; then
    printf '%s\n' "$kitana_file"
  fi
}

write_hidden_desktop_override() {
  local source_file="$1"
  local desktop_id="${source_file##*/}"
  local target_file="$HOME/.local/share/applications/$desktop_id"
  local system_file="/usr/share/applications/$desktop_id"
  local base_file="$source_file"
  local tmp_file

  [ -f "$system_file" ] && base_file="$system_file"
  tmp_file="$(mktemp)"

  grep -Eiv '^[[:space:]]*(NoDisplay|Hidden|X-Kitana-Managed)[[:space:]]*=' "$base_file" > "$tmp_file" || true

  if grep -q '^\[Desktop Entry\]' "$tmp_file"; then
    cp "$tmp_file" "$target_file"
  else
    {
      printf '[Desktop Entry]\n'
      grep -Ev '^\[Desktop Entry\]$' "$tmp_file" || true
    } > "$target_file"
  fi

  {
    printf 'NoDisplay=true\n'
    printf 'X-Kitana-Managed=true\n'
  } >> "$target_file"

  rm -f "$tmp_file"
}

refresh_applications() {
  mkdir -p "$HOME/.local/share/applications" "$USER_HIDDEN_APPLICATIONS_DIR"
  rm -f "$HOME/.local/share/applications/kitana-hidden-desktop-ids"

  local hidden_dir desktop_file desktop_id source_file target_file
  for hidden_dir in "$KITANA_HIDDEN_APPLICATIONS_DIR" "$USER_HIDDEN_APPLICATIONS_DIR"; do
    [ -d "$hidden_dir" ] || continue
    for desktop_file in "$hidden_dir"/*.desktop; do
      [ -e "$desktop_file" ] || continue
      desktop_id="${desktop_file##*/}"
      source_file="$(hidden_desktop_source "$desktop_id")"
      [ -n "$source_file" ] || continue
      target_file="$HOME/.local/share/applications/$desktop_id"

      if desktop_entry_hides "$source_file"; then
        write_hidden_desktop_override "$source_file"
      elif [ -f "$target_file" ] && grep -q '^X-Kitana-Managed=true$' "$target_file"; then
        rm -f "$target_file"
      fi
    done
  done

  for target_file in "$HOME/.local/share/applications"/*.desktop; do
    [ -e "$target_file" ] || continue
    grep -q '^X-Kitana-Managed=true$' "$target_file" || continue
    desktop_id="${target_file##*/}"
    source_file="$(hidden_desktop_source "$desktop_id")"

    if [ -z "$source_file" ] || ! desktop_entry_hides "$source_file"; then
      rm -f "$target_file"
    fi
  done

  bash "$KITANA_DIR/install/apps/webapps.sh"

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$HOME/.local/share/applications" || true
  fi
}

refresh_configs() {
  bash "$KITANA_DIR/install/desktop/configs.sh"
  "$KITANA_DIR/bin/kitana-quickshell-build-cava" --if-deps
}

refresh_wallpapers() {
  kitana-install-extras-wallpapers
}

run_sddm() {
  if [ "$sddm_dry_run" -eq 1 ]; then
    printf '+'
    local arg
    for arg in "$@"; do
      printf ' %q' "$arg"
    done
    printf '\n'
  else
    "$@"
  fi
}

write_sddm_wayland_conf() {
  local wayland_conf="$1"

  if [ "$sddm_dry_run" -eq 1 ]; then
    printf '+ write %s\n' "$wayland_conf"
    return
  fi

  sudo tee "$wayland_conf" >/dev/null <<EOF
[General]
DisplayServer=wayland

[Wayland]
CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.lua
EOF
}

write_sddm_theme_conf() {
  local theme_conf="$1"

  if [ "$sddm_dry_run" -eq 1 ]; then
    printf '+ write %s\n' "$theme_conf"
    return
  fi

  sudo tee "$theme_conf" >/dev/null <<EOF
[Theme]
Current=kitana
EOF
}

remove_old_sddm_dropins() {
  run_sddm sudo rm -f /usr/share/sddm/hyprland.conf /etc/kitana/sddm-hyprland.conf

  if [ -f /etc/sddm.conf.d/20-hyprland.conf ] && grep -q '/etc/kitana/sddm-hyprland.conf' /etc/sddm.conf.d/20-hyprland.conf; then
    run_sddm sudo rm -f /etc/sddm.conf.d/20-hyprland.conf
  fi

  if [ -f /etc/sddm.conf.d/10-theme.conf ] && grep -q '^Current=pixie$' /etc/sddm.conf.d/10-theme.conf; then
    run_sddm sudo rm -f /etc/sddm.conf.d/10-theme.conf
  fi
}

valid_sddm_focus_monitor() {
  local value="$1"

  [ "${#value}" -le 512 ] || return 1
  [[ "$value" != *$'\n'* ]] || return 1
  [[ "$value" != *$'\r'* ]] || return 1
}

write_sddm_focus_monitor() {
  local focus_file="$1"
  local focus_monitor="$2"
  local owner="$3"
  local group="$4"

  if [ "$sddm_dry_run" -eq 1 ]; then
    printf '+ write %s\n' "$focus_file"
  elif [ -n "$focus_monitor" ]; then
    printf '%s\n' "$focus_monitor" | sudo tee "$focus_file" >/dev/null
  else
    sudo install -m 0644 /dev/null "$focus_file"
  fi

  if [ -n "$owner" ] && [ -n "$group" ]; then
    run_sddm sudo chown "$owner:$group" "$focus_file"
  fi
  run_sddm sudo chmod 0644 "$focus_file"
}

refresh_sddm() {
  local source_theme="$KITANA_DIR/default/sddm/theme"
  local target_theme="/usr/share/sddm/themes/kitana"
  local target_hyprland="/usr/share/sddm/hyprland.lua"
  local wayland_conf="/etc/sddm.conf.d/10-wayland.conf"
  local theme_conf="/etc/sddm.conf.d/20-theme.conf"
  local sddm_cache_dir="/var/lib/kitana/sddm"
  local sddm_background="$sddm_cache_dir/background"
  local sddm_focus_file="$sddm_cache_dir/focus-monitor"
  local default_background="$KITANA_DIR/default/wallpapers/kitana-wallpaper-001.jpg"
  local selected_background=""
  local owner="${SUDO_USER:-${USER:-}}"
  local group=""
  local env_sddm_focus_monitor="${KITANA_SDDM_FOCUS_MONITOR:-}"
  local sddm_focus_monitor=""

  if [ -f "$HOME/.config/kitana/config" ]; then
    # shellcheck disable=SC1090
    source "$HOME/.config/kitana/config"
  fi
  sddm_focus_monitor="${env_sddm_focus_monitor:-${KITANA_SDDM_FOCUS_MONITOR:-}}"

  if [ -n "$sddm_focus_monitor" ] && ! valid_sddm_focus_monitor "$sddm_focus_monitor"; then
    echo "Ignoring invalid KITANA_SDDM_FOCUS_MONITOR: $sddm_focus_monitor" >&2
    sddm_focus_monitor=""
  fi

  if [ ! -f "$KITANA_DIR/default/sddm/hyprland.lua" ]; then
    echo "Missing SDDM Hyprland config: $KITANA_DIR/default/sddm/hyprland.lua" >&2
    exit 1
  fi

  if [ ! -d "$source_theme" ]; then
    echo "Missing SDDM theme source: $source_theme" >&2
    exit 1
  fi

  if [ -n "$owner" ]; then
    group="$(id -gn "$owner" 2>/dev/null || true)"
  fi

  if [ -e "$HOME/.config/kitana/current-wallpaper" ]; then
    selected_background="$HOME/.config/kitana/current-wallpaper"
  elif [ -f "$default_background" ]; then
    selected_background="$default_background"
  fi

  run_sddm sudo mkdir -p /usr/share/sddm /usr/share/sddm/themes /etc/sddm.conf.d /var/lib/kitana "$sddm_cache_dir"
  run_sddm sudo chmod 755 /var/lib/kitana "$sddm_cache_dir"

  if [ -n "$selected_background" ]; then
    run_sddm sudo cp --reflink=auto -L "$selected_background" "$sddm_background" || run_sddm sudo cp -L "$selected_background" "$sddm_background"
    if [ -n "$owner" ] && [ -n "$group" ]; then
      run_sddm sudo chown "$owner:$group" "$sddm_background"
    fi
    run_sddm sudo chmod 0644 "$sddm_background"
  fi

  write_sddm_focus_monitor "$sddm_focus_file" "$sddm_focus_monitor" "$owner" "$group"

  run_sddm sudo cp "$KITANA_DIR/default/sddm/hyprland.lua" "$target_hyprland"
  remove_old_sddm_dropins
  run_sddm sudo rm -rf "$target_theme"
  run_sddm sudo cp -r "$source_theme" "$target_theme"

  write_sddm_wayland_conf "$wayland_conf"
  write_sddm_theme_conf "$theme_conf"

  echo "Kitana SDDM theme refreshed."
  echo "Test with: sddm-greeter --test-mode --theme $target_theme"

  if [ "$sddm_test_mode" -eq 1 ]; then
    if [ "$sddm_dry_run" -eq 1 ]; then
      echo "+ sddm-greeter --test-mode --theme $target_theme"
    else
      sddm-greeter --test-mode --theme "$target_theme"
    fi
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --applications)
      add_target applications
      ;;
    --configs)
      add_target configs
      ;;
    --sddm)
      add_target sddm
      ;;
    --wallpapers)
      add_target wallpapers
      ;;
    --dry-run)
      sddm_dry_run=1
      ;;
    --test-mode)
      sddm_test_mode=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [ "${#targets[@]}" -eq 0 ]; then
  usage >&2
  exit 2
fi

for target in "${targets[@]}"; do
  case "$target" in
    applications) refresh_applications ;;
    configs) refresh_configs ;;
    sddm) refresh_sddm ;;
    wallpapers) refresh_wallpapers ;;
  esac
done
