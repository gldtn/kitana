#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
lua_path="$kitana_dir/lib/?.lua;$kitana_dir/lib/?/init.lua;;"
theme="${1:-}"
theme_env=""

if [ -z "$theme" ]; then
  printf 'Usage: %s THEME\n' "$(basename "$0")" >&2
  exit 2
fi

theme_env="$(LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" env "$theme")" || exit 1
eval "$theme_env"

if [ -z "$neovim_colorscheme" ]; then
  exit 0
fi

nvim_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/nvim"
mkdir -p "$nvim_data_dir"
printf '%s\n' "$neovim_colorscheme" >"$nvim_data_dir/last-theme.txt"
