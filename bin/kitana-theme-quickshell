#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
template="$kitana_dir/config/quickshell/kitana/Config/Colors.qml"
target="$HOME/.config/quickshell/kitana/Config/Colors.qml"
legacy_target="$HOME/.config/quickshell/kitana/Colors.qml"
theme="${1:-}"
theme_env=""

if [ -z "$theme" ]; then
  printf 'Usage: %s THEME\n' "$(basename "$0")" >&2
  exit 2
fi

theme_env="$(lua "$kitana_dir/lib/kitana-theme.lua" env "$theme")" || exit 1
eval "$theme_env"
mkdir -p "$(dirname "$target")"

export crust0 crust1 mantle0 mantle1 base0 base1 surface0 surface1 overlay0 overlay1 subtext0 subtext1 text0 text1 accent0 accent1 info0 success0 warning0 danger0

lua - "$template" "$target" <<'LUA'
local template_path = arg[1]
local target_path = arg[2]
local fields = {
  "crust0",
  "crust1",
  "mantle0",
  "mantle1",
  "base0",
  "base1",
  "surface0",
  "surface1",
  "overlay0",
  "overlay1",
  "subtext0",
  "subtext1",
  "text0",
  "text1",
  "accent0",
  "accent1",
  "info0",
  "success0",
  "warning0",
  "danger0",
}

local function read_file(path)
  local file = assert(io.open(path, "r"))
  local content = file:read("*a")
  file:close()
  return content
end

local function write_file(path, content)
  local file = assert(io.open(path, "w"))
  file:write(content)
  file:close()
end

local content = read_file(template_path)

for _, field in ipairs(fields) do
  local value = assert(os.getenv(field), "missing theme field: " .. field):gsub("^#", "")
  local pattern = "(readonly%s+property%s+string%s+" .. field .. "%s*:%s*\")[^\"]*(\")"
  local replacement = "%1" .. value .. "%2"
  local count
  content, count = content:gsub(pattern, replacement, 1)
  assert(count == 1, "missing Colors.qml raw palette field: " .. field)
end

write_file(target_path, content)
LUA

if [ -f "$legacy_target" ] && grep -q "Kitana managed Quickshell colors" "$legacy_target"; then
  rm "$legacy_target"
fi
