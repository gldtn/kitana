#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
template="$kitana_dir/config/quickshell/kitana/Config/Colors.qml"
target="$HOME/.config/quickshell/kitana/Config/Colors.qml"
legacy_target="$HOME/.config/quickshell/kitana/Colors.qml"
theme="${1:-}"
theme_env=""

if [ -z "$theme" ]; then
  printf 'Usage: %s THEME\n' "$(basename "$0")" >&2
  exit 2
fi

theme_env="$(lua "$kitana_dir/lib/kitana-theme.lua" quickshell-env "$theme")" || exit 1
set -a
eval "$theme_env"
set +a
mkdir -p "$(dirname "$target")"

lua "$kitana_dir/lib/kitana-quickshell-colors.lua" "$template" "$target"

if [ -f "$legacy_target" ] && grep -q "Kitana managed Quickshell colors" "$legacy_target"; then
  rm "$legacy_target"
fi
