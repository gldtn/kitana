        "ghost_element.hover": "${surface0}99",
        "ghost_element.active": "$surface1",
        "ghost_element.selected": "${accent0}22",
        "ghost_element.disabled": "${surface1}66",
        "text": "$text0",
        "text.muted": "$subtext0",
        "text.placeholder": "${subtext0}99",
        "text.disabled": "${text0}66",
        "text.accent": "$accent0",
        "icon": "$text0",
        "icon.muted": "$subtext0",
        "icon.placeholder": "${subtext0}99",
        "icon.disabled": "${text0}66",
        "icon.accent": "$accent0",
        "search.match_background": "${warning0}55",
        "search.active_match_background": "${danger0}55",
