        "terminal.ansi.dim_white": "$subtext0",
        "link_text.hover": "$accent0",
        "version_control.added": "$accent1",
        "version_control.modified": "$warning0",
        "version_control.deleted": "$danger0",
        "version_control.word_added": "${accent1}33",
        "version_control.word_deleted": "${danger0}33",
        "created": "$accent1",
        "created.background": "${accent1}1a",
        "created.border": "$accent1",
        "modified": "$warning0",
        "modified.background": "${warning0}1a",
        "modified.border": "$warning0",
        "deleted": "$danger0",
        "deleted.background": "${danger0}1a",
        "deleted.border": "$danger0",
