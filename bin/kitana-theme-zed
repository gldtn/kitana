          "string.escape": { "color": "$warning0", "font_style": null, "font_weight": null },
          "string.regex": { "color": "$warning0", "font_style": null, "font_weight": null },
          "tag": { "color": "$accent0", "font_style": null, "font_weight": null },
          "text.literal": { "color": "$accent1", "font_style": null, "font_weight": null },
          "title": { "color": "$danger0", "font_style": null, "font_weight": 400 },
          "type": { "color": "$accent0", "font_style": null, "font_weight": null },
          "variable": { "color": "$text0", "font_style": null, "font_weight": null },
          "variable.special": { "color": "$warning0", "font_style": null, "font_weight": null },
          "variant": { "color": "$accent0", "font_style": null, "font_weight": null },
