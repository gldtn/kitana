#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
lua_path="$kitana_dir/lib/?.lua;$kitana_dir/lib/?/init.lua;;"
zed_config_dir="$HOME/.config/zed"
zed_theme_dir="$zed_config_dir/themes"
zed_theme_file="$zed_theme_dir/kitana-dynamic.json"
theme="${1:-}"
theme_env=""

if [ -z "$theme" ]; then
  printf 'Usage: %s THEME\n' "$(basename "$0")" >&2
  exit 2
fi

theme_env="$(LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" env "$theme")" || exit 1
eval "$theme_env"
mkdir -p "$zed_theme_dir"

zed_source_path=""
if [ -n "$zed_source_file" ]; then
  zed_source_path="$kitana_dir/$zed_source_file"
fi

if [ -n "$zed_source_path" ] && [ -f "$zed_source_path" ]; then
  jq --arg theme_name "$zed_theme_name" '
    . as $root
    | ($root.themes[] | select(.name == $theme_name)) as $theme
    | {
        "$schema": ($root["$schema"] // "https://zed.dev/schema/themes/v0.2.0.json"),
        "name": "Kitana Dynamic",
        "author": ($root.author // "Kitana"),
        "themes": [($theme | .name = "Kitana Dynamic")]
      }
  ' "$zed_source_path" >"$zed_theme_file"

  if ! jq -e '.themes | length == 1' "$zed_theme_file" >/dev/null; then
    printf 'Zed theme not found in %s: %s\n' "$zed_source_file" "$zed_theme_name" >&2
    exit 1
  fi

  if [ -f "$zed_config_dir/settings.json" ]; then
    touch "$zed_config_dir/settings.json"
  fi
  exit 0
fi

cat >"$zed_theme_file" <<EOF
{
  "\$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Kitana Dynamic",
  "author": "Kitana",
  "themes": [
    {
      "name": "Kitana Dynamic",
      "appearance": "dark",
      "style": {
        "accents": ["$accent0", "$warning0", "$danger0"],
        "background.appearance": "opaque",
        "background": "$base0",
        "surface.background": "$base1",
        "elevated_surface.background": "$surface1",
        "panel.background": "$base0",
        "status_bar.background": "$base0",
        "title_bar.background": "$base0",
        "title_bar.inactive_background": "$base1",
        "toolbar.background": "$base0",
        "tab_bar.background": "$base0",
        "tab.inactive_background": "$base1",
        "tab.active_background": "$base0",
        "border": "$surface1",
        "border.variant": "$surface0",
        "border.focused": "$accent0",
        "border.selected": "$accent0",
