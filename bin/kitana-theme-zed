          "emphasis": { "color": "$accent0", "font_style": "italic", "font_weight": null },
          "emphasis.strong": { "color": "$warning0", "font_style": null, "font_weight": 700 },
          "enum": { "color": "$accent0", "font_style": null, "font_weight": null },
          "function": { "color": "$accent0", "font_style": null, "font_weight": null },
          "keyword": { "color": "$danger0", "font_style": "italic", "font_weight": null },
          "label": { "color": "$accent0", "font_style": null, "font_weight": null },
          "link_text": { "color": "$accent0", "font_style": "italic", "font_weight": null },
          "link_uri": { "color": "$accent0", "font_style": null, "font_weight": null },
          "namespace": { "color": "$text0", "font_style": null, "font_weight": null },
          "number": { "color": "$warning0", "font_style": null, "font_weight": null },
          "operator": { "color": "$accent0", "font_style": null, "font_weight": null },
          "predictive": { "color": "$subtext0", "font_style": "italic", "font_weight": null },
          "preproc": { "color": "$danger0", "font_style": null, "font_weight": null },
          "primary": { "color": "$text0", "font_style": null, "font_weight": null },
          "property": { "color": "$danger0", "font_style": null, "font_weight": null },
          "punctuation": { "color": "$text0", "font_style": null, "font_weight": null },
          "punctuation.bracket": { "color": "$subtext0", "font_style": null, "font_weight": null },
