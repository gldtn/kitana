#!/bin/bash

set -euo pipefail

KITANA_DIR="${KITANA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
binary="$KITANA_DIR/target/release/kitana-bluetooth-pair"

if [ ! -x "$binary" ]; then
  if ! command -v cargo >/dev/null 2>&1; then
    echo "kitana-bluetooth-pair: Rust binary missing and cargo is not installed: $binary" >&2
    exit 1
  fi

  echo "kitana-bluetooth-pair: building Rust helper" >&2
  cargo build --release --bin kitana-bluetooth-pair --manifest-path "$KITANA_DIR/Cargo.toml" >&2
fi

exec "$binary" "$@"
