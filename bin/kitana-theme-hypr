#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
hypr_theme_file="$HOME/.config/hypr/kitana-theme.lua"
theme="${1:-}"
theme_env=""

if [ -z "$theme" ]; then
  printf 'Usage: %s THEME\n' "$(basename "$0")" >&2
  exit 2
fi

theme_env="$(lua "$kitana_dir/lib/kitana-theme.lua" env "$theme")" || exit 1
eval "$theme_env"

active_hex="${hypr_border_active#\#}"
inactive_hex="${hypr_border_inactive#\#}"

if ! [[ "$active_hex" =~ ^[0-9a-fA-F]{6}$ ]]; then
  printf 'Invalid Hyprland active border color for %s: %s\n' "$theme" "$hypr_border_active" >&2
  exit 1
fi

if ! [[ "$inactive_hex" =~ ^[0-9a-fA-F]{6}$ ]]; then
  printf 'Invalid Hyprland inactive border color for %s: %s\n' "$theme" "$hypr_border_inactive" >&2
  exit 1
fi

mkdir -p "$(dirname "$hypr_theme_file")"
cat >"$hypr_theme_file" <<EOF
-- Kitana managed Hyprland theme
return {
  border_active = "rgba(${active_hex}ee)",
  border_inactive = "rgba(${inactive_hex}aa)",
}
EOF

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload >/dev/null 2>&1 || true
fi
