          { "cursor": "$accent", "background": "${accent}80", "selection": "${accent}3d" },
          { "cursor": "$danger", "background": "${danger}80", "selection": "${danger}3d" },
          { "cursor": "$warning", "background": "${warning}80", "selection": "${warning}3d" },
          { "cursor": "$foreground", "background": "${foreground}80", "selection": "${foreground}3d" }
