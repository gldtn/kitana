#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
state_dir="$HOME/.config/kitana"
state_file="$state_dir/theme"
target="$HOME/.config/quickshell/kitana/Colors.qml"
ghostty_config_dir="$HOME/.config/ghostty"
ghostty_theme_file="$ghostty_config_dir/kitana-theme.conf"
zed_config_dir="$HOME/.config/zed"
zed_theme_dir="$zed_config_dir/themes"
zed_theme_file="$zed_theme_dir/kitana-dynamic.json"

themes=(
  "catppuccin-mocha|Catppuccin Mocha|#1e1e2e|#313244|#45475a|#cdd6f4|#9399b2|#89b4fa|#11111b|#f9e2af|#f38ba8"
  "rose-pine|Rose Pine|#191724|#26233a|#403d52|#e0def4|#908caa|#c4a7e7|#191724|#f6c177|#eb6f92"
  "tokyo-night|Tokyo Night|#1a1b26|#24283b|#414868|#c0caf5|#565f89|#7aa2f7|#1a1b26|#e0af68|#f7768e"
  "dracula|Dracula|#282a36|#343746|#44475a|#f8f8f2|#b6b6c8|#bd93f9|#282a36|#f1fa8c|#ff5555"
  "kanagawa-dragon|Kanagawa Dragon|#181616|#1f1f28|#393836|#c5c9c5|#a6a69c|#8ba4b0|#181616|#c4b28a|#c4746e"
)

usage() {
  printf 'Usage: %s [--list|--restore|THEME]\n' "$(basename "$0")"
}

find_theme() {
  local requested="$1"
  local theme slug name

  for theme in "${themes[@]}"; do
    IFS='|' read -r slug name _ <<<"$theme"
    if [ "$requested" = "$slug" ] || [ "$requested" = "$name" ]; then
      printf '%s\n' "$theme"
      return 0
    fi
  done

  return 1
}

ghostty_theme_name() {
  case "$1" in
    catppuccin-mocha) printf 'Catppuccin Mocha\n' ;;
    rose-pine) printf 'Rose Pine\n' ;;
    tokyo-night) printf 'TokyoNight\n' ;;
    dracula) printf 'Dracula\n' ;;
    kanagawa-dragon) printf 'Kanagawa Dragon\n' ;;
  esac
}

write_ghostty_theme() {
  local slug="$1"
  local ghostty_theme

  ghostty_theme="$(ghostty_theme_name "$slug")"
  [ -n "$ghostty_theme" ] || return 0

  mkdir -p "$ghostty_config_dir"
  printf '# Kitana managed Ghostty theme\ntheme = %s\n' "$ghostty_theme" >"$ghostty_theme_file"

  if command -v ghostty >/dev/null 2>&1 && [ -f "$ghostty_config_dir/config" ]; then
    ghostty +validate-config --config-file="$ghostty_config_dir/config" >/dev/null
  fi

  if systemctl --user is-active --quiet app-com.mitchellh.ghostty.service 2>/dev/null; then
    systemctl reload --user app-com.mitchellh.ghostty.service >/dev/null 2>&1 || true
  elif pgrep -x ghostty >/dev/null 2>&1; then
    killall -SIGUSR2 ghostty >/dev/null 2>&1 || true
  fi
}

