#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
lua_path="$kitana_dir/lib/?.lua;$kitana_dir/lib/?/init.lua;;"
state_dir="$HOME/.config/kitana"
state_file="$state_dir/theme"

usage() {
  printf 'Usage: %s [--list|--restore|THEME]\n' "$(basename "$0")"
}

notify_theme() {
  local theme_name="$1"

  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send \
    --app-name="Kitana" \
    --icon="preferences-desktop-theme" \
    --expire-time=2200 \
    "Theme applied" \
    "$theme_name" >/dev/null 2>&1 || true
}

find_theme() {
  LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" find "$1"
}

apply_theme() {
  local requested="$1"
  local notify="${2:-0}"
  local current_slug slug theme_env name

  slug="$(find_theme "$requested")" || {
    printf 'Unknown theme: %s\n' "$requested" >&2
    exit 1
  }

  if [ -f "$state_file" ]; then
    current_slug="$(<"$state_file")"
  else
    current_slug=""
  fi

  theme_env="$(LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" env "$slug")" || exit 1
  eval "$theme_env"
  mkdir -p "$state_dir"

  "$kitana_dir/bin/kitana-theme-quickshell" "$slug"
  "$kitana_dir/bin/kitana-theme-ghostty" "$slug"
  "$kitana_dir/bin/kitana-theme-zed" "$slug"
  "$kitana_dir/bin/kitana-theme-hypr" "$slug"
  "$kitana_dir/bin/kitana-theme-neovim" "$slug" || true

  printf '%s\n' "$slug" >"$state_file"
  if [ "$notify" -eq 1 ] && [ "$current_slug" != "$slug" ]; then
    notify_theme "$name"
  fi
  printf 'Theme applied: %s\n' "$name"
}

case "${1:-}" in
  --list)
    LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" list
    ;;
  --restore)
    if [ -f "$state_file" ]; then
      if [ "$(<"$state_file")" = "matugen" ]; then
        exit 0
      fi
      apply_theme "$(<"$state_file")" 0
    fi
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    apply_theme "$1" 1
    ;;
esac
