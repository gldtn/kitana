          "constant": { "color": "$warning", "font_style": null, "font_weight": null },
          "constructor": { "color": "$accent", "font_style": null, "font_weight": null },
          "embedded": { "color": "$foreground", "font_style": null, "font_weight": null },
          "emphasis": { "color": "$accent", "font_style": "italic", "font_weight": null },
          "emphasis.strong": { "color": "$warning", "font_style": null, "font_weight": 700 },
          "enum": { "color": "$accent", "font_style": null, "font_weight": null },
          "function": { "color": "$accent", "font_style": null, "font_weight": null },
          "keyword": { "color": "$danger", "font_style": "italic", "font_weight": null },
          "label": { "color": "$accent", "font_style": null, "font_weight": null },
          "link_text": { "color": "$accent", "font_style": "italic", "font_weight": null },
          "link_uri": { "color": "$accent", "font_style": null, "font_weight": null },
          "namespace": { "color": "$foreground", "font_style": null, "font_weight": null },
          "number": { "color": "$warning", "font_style": null, "font_weight": null },
          "operator": { "color": "$accent", "font_style": null, "font_weight": null },
          "predictive": { "color": "$muted", "font_style": "italic", "font_weight": null },
