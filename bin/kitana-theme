        "terminal.ansi.bright_blue": "$accent",
        "terminal.ansi.dim_blue": "$accent",
        "terminal.ansi.magenta": "$surface_alt",
        "terminal.ansi.bright_magenta": "$accent",
        "terminal.ansi.dim_magenta": "$surface_alt",
        "terminal.ansi.cyan": "$accent",
        "terminal.ansi.bright_cyan": "$accent",
        "terminal.ansi.dim_cyan": "$accent",
        "terminal.ansi.white": "$foreground",
        "terminal.ansi.bright_white": "$foreground",
        "terminal.ansi.dim_white": "$muted",
        "link_text.hover": "$accent",
        "version_control.added": "$accent",
        "version_control.modified": "$warning",
        "version_control.deleted": "$danger",
        "version_control.word_added": "${accent}33",
        "version_control.word_deleted": "${danger}33",
        "created": "$accent",
        "created.background": "${accent}1a",
        "created.border": "$accent",
        "modified": "$warning",
        "modified.background": "${warning}1a",
        "modified.border": "$warning",
        "deleted": "$danger",
        "deleted.background": "${danger}1a",
        "deleted.border": "$danger",
        "error": "$danger",
        "error.background": "${danger}1a",
        "error.border": "$danger",
        "warning": "$warning",
        "warning.background": "${warning}1a",
        "warning.border": "$warning",
        "info": "$accent",
        "info.background": "${accent}1a",
        "info.border": "$accent",
        "hint": "$accent",
        "hint.background": "${accent}1a",
        "hint.border": "$accent",
        "success": "$accent",
        "success.background": "${accent}1a",
        "success.border": "$accent",
        "conflict": "$warning",
