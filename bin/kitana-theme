#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
wallpaper_extras_dir="${KITANA_WALLPAPER_EXTRAS_DIR:-$HOME/.local/share/kitana-wallpapers-extras}"
lua_path="$kitana_dir/lib/?.lua;$kitana_dir/lib/?/init.lua;;"
state_dir="$HOME/.config/kitana"
state_file="$state_dir/theme"

usage() {
  printf 'Usage: %s [--list|--restore|THEME]\n' "$(basename "$0")"
}

notify_theme() {
  local theme_name="$1"

  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send \
    --app-name="Kitana" \
    --icon="preferences-desktop-theme" \
    --expire-time=2200 \
    "Theme applied" \
    "$theme_name" >/dev/null 2>&1 || true
}

find_theme() {
  LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" find "$1"
}

current_wallpaper_name() {
  local selected=""

  if [ -e "$state_dir/current-wallpaper" ] || [ -L "$state_dir/current-wallpaper" ]; then
    selected="$(readlink -f "$state_dir/current-wallpaper" 2>/dev/null || true)"
  fi

  if [ -z "$selected" ] && [ -f "$state_dir/wallpaper" ]; then
    selected="$(<"$state_dir/wallpaper")"
  fi

  [ -n "$selected" ] || return 0
  basename "$selected"
}

sync_wallpaper_set() {
  local slug="$1"
  local wallpaper_name="${2:-}"
  local switcher="$wallpaper_extras_dir/scripts/use-wallpaper-set"
  local theme_wallpaper

  [ -x "$switcher" ] || return 0
  [ -d "$wallpaper_extras_dir/wallpapers/$slug" ] || return 0

  if ! "$switcher" --quiet "$slug"; then
    printf 'Wallpaper set not updated: %s\n' "$slug" >&2
    return 0
  fi

  [ -n "$wallpaper_name" ] || return 0
  theme_wallpaper="$wallpaper_extras_dir/wallpapers/$slug/$wallpaper_name"
  [ -f "$theme_wallpaper" ] || return 0

  if ! "$kitana_dir/bin/kitana-wallpaper" "$theme_wallpaper" >/dev/null; then
    printf 'Wallpaper image not updated: %s\n' "$wallpaper_name" >&2
  fi
}

run_background_integrations() {
  local slug="$1"

  {
    [ "$(<"$state_file")" = "$slug" ] && "$kitana_dir/bin/kitana-theme-ghostty" "$slug" || true
    [ "$(<"$state_file")" = "$slug" ] && "$kitana_dir/bin/kitana-theme-zed" "$slug" || true
    [ "$(<"$state_file")" = "$slug" ] && "$kitana_dir/bin/kitana-theme-neovim" "$slug" || true
    [ "$(<"$state_file")" = "$slug" ] && "$kitana_dir/bin/kitana-theme-cava" "$slug" || true
    [ "$(<"$state_file")" = "$slug" ] && "$kitana_dir/bin/kitana-theme-opencode" "$slug" || true
  } >/tmp/kitana-theme-integrations.log 2>&1 &
}

apply_theme() {
  local requested="$1"
  local notify="${2:-0}"
  local current_slug current_wallpaper slug theme_env name

  slug="$(find_theme "$requested")" || {
    printf 'Unknown theme: %s\n' "$requested" >&2
    exit 1
  }

  if [ -f "$state_file" ]; then
    current_slug="$(<"$state_file")"
  else
    current_slug=""
  fi
  current_wallpaper="$(current_wallpaper_name)"

  theme_env="$(LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" env "$slug")" || exit 1
  eval "$theme_env"
  mkdir -p "$state_dir"

  printf '%s\n' "$slug" >"$state_file"
  "$kitana_dir/bin/kitana-theme-quickshell" "$slug"
  "$kitana_dir/bin/kitana-theme-hypr" "$slug"
  sync_wallpaper_set "$slug" "$current_wallpaper"

  run_background_integrations "$slug"

  if [ "$notify" -eq 1 ] && [ "$current_slug" != "$slug" ]; then
    notify_theme "$name"
  fi
  printf 'Theme applied: %s\n' "$name"
}

case "${1:-}" in
  --list)
    LUA_PATH="$lua_path" lua "$kitana_dir/lib/kitana-theme.lua" list
    ;;
  --restore)
    if [ -f "$state_file" ]; then
      if [ "$(<"$state_file")" = "matugen" ]; then
        exit 0
      fi
      apply_theme "$(<"$state_file")" 0
    fi
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    apply_theme "$1" 1
    ;;
esac
