#!/bin/bash

set -euo pipefail

kitana_dir="${KITANA_DIR:-$HOME/.local/share/kitana}"
state_dir="$HOME/.config/kitana"
state_file="$state_dir/theme"

usage() {
  printf 'Usage: %s [--list|--restore|THEME]\n' "$(basename "$0")"
}

find_theme() {
  lua "$kitana_dir/lib/kitana-theme.lua" find "$1"
}

apply_theme() {
  local requested="$1"
  local slug theme_env name

  slug="$(find_theme "$requested")" || {
    printf 'Unknown theme: %s\n' "$requested" >&2
    exit 1
  }

  theme_env="$(lua "$kitana_dir/lib/kitana-theme.lua" env "$slug")" || exit 1
  eval "$theme_env"
  mkdir -p "$state_dir"

  "$kitana_dir/bin/kitana-theme-quickshell" "$slug"
  "$kitana_dir/bin/kitana-theme-ghostty" "$slug"
  "$kitana_dir/bin/kitana-theme-zed" "$slug"
  "$kitana_dir/bin/kitana-theme-hypr" "$slug"
  "$kitana_dir/bin/kitana-theme-neovim" "$slug" || true

  printf '%s\n' "$slug" >"$state_file"
  "$kitana_dir/bin/kitana-quickshell" >/dev/null 2>&1 || true
  printf 'Theme applied: %s\n' "$name"
}

case "${1:-}" in
  --list)
    lua "$kitana_dir/lib/kitana-theme.lua" list
    ;;
  --restore)
    if [ -f "$state_file" ]; then
      apply_theme "$(<"$state_file")"
    fi
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    apply_theme "$1"
    ;;
esac
