          "punctuation": { "color": "$foreground", "font_style": null, "font_weight": null },
          "punctuation.bracket": { "color": "$muted", "font_style": null, "font_weight": null },
          "punctuation.delimiter": { "color": "$muted", "font_style": null, "font_weight": null },
          "selector": { "color": "$accent", "font_style": null, "font_weight": null },
          "string": { "color": "$accent", "font_style": null, "font_weight": null },
          "string.escape": { "color": "$warning", "font_style": null, "font_weight": null },
