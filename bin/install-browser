#!/usr/bin/env bash

# Script to install a browser and save the choice for webapp-install

KITANA_DIR="${KITANA_DIR:-$HOME/.local/share/kitana}"

# shellcheck source=../install/lib/install.sh
source "$KITANA_DIR/install/lib/install.sh"

if ! command -v yay &> /dev/null; then
    echo "Error: yay is not installed. Please install it first."
    echo ""
    exit 1
fi

# Header
if ! kitana_is_unattended && command -v gum >/dev/null 2>&1; then
    ~/.local/share/kitana/bin/show-logo
    gum format -- "## Browser Installation Script"
    echo ""
fi

# List of popular browsers with package:executable mapping
browsers=(
    "brave-bin:brave:Fast and privacy-focused browser"
    "chromium:chromium:Open-source version of Chrome"
    "firefox:firefox:Popular open-source browser"
    "google-chrome:google-chrome-stable:Google's proprietary browser"
    "qutebrowser:qutebrowser:Keyboard-oriented browser"
    "zen-browser-bin:zen-browser:Web browser based on Mozilla Firefox"
)

save_browser_choice() {
    mkdir -p ~/.config
    echo "BROWSER=$1" > ~/.config/webapp-install.conf
}

install_browser_package() {
    local pkg_name="$1"
    local browser_exec="$2"
    local command=(yay -S --noconfirm --needed "$pkg_name")
    local retry=(yay -S --noconfirm --needed --answerclean All "$pkg_name")

    echo "Installing $pkg_name..."
    if kitana_run_logged "apps/browser" "$pkg_name" "browser" "${command[@]}"; then
        save_browser_choice "$browser_exec"
        command -v gum >/dev/null 2>&1 && ! kitana_is_unattended && gum style --foreground 2 "Successfully installed $pkg_name!"
        echo ""
        return 0
    fi

    local exit_code="${KITANA_LAST_EXIT_CODE:-1}"
    kitana_log_failure "apps/browser" "$pkg_name" "${command[*]}" "$exit_code" "yay -S $pkg_name" "${KITANA_LAST_COMMAND_LOG:-}"

    echo "$pkg_name install failed. Retrying with a clean AUR build..."
    if kitana_run_logged "apps/browser" "$pkg_name" "browser-clean-retry" "${retry[@]}"; then
        save_browser_choice "$browser_exec"
        kitana_log_report "Browser package succeeded after clean retry: $pkg_name"
        command -v gum >/dev/null 2>&1 && ! kitana_is_unattended && gum style --foreground 2 "Successfully installed $pkg_name after clean retry!"
        echo ""
        return 0
    fi

    exit_code="${KITANA_LAST_EXIT_CODE:-1}"
    kitana_log_failure "apps/browser" "$pkg_name" "${retry[*]}" "$exit_code" "yay -S --answerclean All $pkg_name" "${KITANA_LAST_COMMAND_LOG:-}"

    if command -v "$browser_exec" >/dev/null 2>&1; then
        save_browser_choice "$browser_exec"
        echo "WARNING: $pkg_name failed, but $browser_exec is already available. Continuing."
        return 0
    fi

    command -v gum >/dev/null 2>&1 && ! kitana_is_unattended && gum style --foreground 1 "Failed to install $pkg_name. Check yay output for details."

    if kitana_is_unattended; then
        echo "WARNING: $pkg_name failed to install and needs manual intervention. Continuing unattended install."
        echo "Manual repair: yay -S --answerclean All $pkg_name"
        echo ""
        return 0
    fi

    echo ""
    return 1
}

browser_choice="${KITANA_BROWSER:-}"

if [ -z "$browser_choice" ] && [ -f "$HOME/.config/webapp-install.conf" ]; then
    # shellcheck disable=SC1090
    source "$HOME/.config/webapp-install.conf"
    browser_choice="${BROWSER:-}"
fi

if [ -z "$browser_choice" ] && kitana_is_unattended; then
    browser_choice="brave"
fi

if [ -n "$browser_choice" ]; then
    selected=""
    for browser in "${browsers[@]}"; do
        pkg="${browser%%:*}"
        rest="${browser#*:}"
        exec="${rest%%:*}"
        if [ "$browser_choice" = "$pkg" ] || [ "$browser_choice" = "$exec" ]; then
            selected="$pkg:$exec"
            break
        fi
    done
else
    if ! command -v gum >/dev/null 2>&1; then
        echo "Error: gum is required for interactive browser selection. Set KITANA_BROWSER for unattended installs."
        exit 1
    fi
    selected=$(gum choose --header "Select a browser to install:" "${browsers[@]}" | cut -d':' -f1-2)
fi

if [ -z "$selected" ]; then
    echo "Unknown browser choice: ${browser_choice:-none}"
    exit 1
fi

# Extract the package name and executable
pkg_name=$(echo "$selected" | cut -d':' -f1)
browser_exec=$(echo "$selected" | cut -d':' -f2)

if kitana_is_unattended || ! command -v gum >/dev/null 2>&1 || gum confirm "Do you want to install $pkg_name?"; then
    install_browser_package "$pkg_name" "$browser_exec"
else
    gum style --foreground 3 "Installation cancelled."
    echo ""
    exit 0
fi
