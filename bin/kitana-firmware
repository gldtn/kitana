#!/bin/bash

set -euo pipefail

command="${1:---help}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [bios|devices|updates|update]

Inspect and update system firmware through fwupd.

Commands:
  bios     Show current system/BIOS information, then list fwupd devices
  devices  List firmware-capable devices known to fwupd
  updates  Refresh LVFS metadata and show available firmware updates
  update   Show current BIOS information, show available updates, confirm, then apply updates

Notes:
  Kitana installs fwupd and refreshes firmware metadata, but never applies firmware updates automatically.
  Firmware updates may require a reboot if updates are installed.
EOF
}

require_fwupdmgr() {
  if ! command -v fwupdmgr >/dev/null 2>&1; then
    echo "fwupdmgr is not installed. Run kitana-reinstall or install fwupd."
    exit 1
  fi
}

print_bios_info() {
  echo "System firmware information:"

  if command -v dmidecode >/dev/null 2>&1; then
    if ! sudo -v; then
      echo "Unable to authenticate for BIOS information."
      return
    fi

    print_dmidecode_fields "BIOS" "bios" "Vendor|Version|Release Date|BIOS Revision|Firmware Revision"
    print_dmidecode_fields "System" "system" "Manufacturer|Product Name|Version"
  else
    echo "dmidecode is not installed."
  fi
}

print_dmidecode_fields() {
  local label="$1"
  local type="$2"
  local fields="$3"
  local info

  echo "$label:"

  if ! info="$(sudo -n dmidecode -t "$type" 2>/dev/null)"; then
    echo "  Unable to read $label information with dmidecode."
    return
  fi

  printf '%s\n' "$info" | awk -F: -v fields="$fields" '
    BEGIN { pattern = "^[[:space:]]*(" fields "):" }
    $0 ~ pattern {
      gsub(/^[[:space:]]+/, "", $1)
      gsub(/^[[:space:]]+/, "", $2)
      print "  " $1 ": " $2
      found = 1
    }
    END {
      if (!found) {
        print "  No matching fields found."
      }
    }
  '
}

confirm_update() {
  if [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1; then
    gum confirm "Apply available firmware updates now? This may require a reboot."
    return $?
  fi

  local answer
  read -r -p "Apply available firmware updates now? This may require a reboot. [y/N] " answer
  [[ "$answer" == "y" || "$answer" == "Y" ]]
}

refresh_metadata() {
  fwupdmgr refresh --force
}

case "$command" in
  bios)
    require_fwupdmgr
    print_bios_info
    echo
    fwupdmgr get-devices
    ;;
  devices)
    require_fwupdmgr
    fwupdmgr get-devices
    ;;
  updates)
    require_fwupdmgr
    refresh_metadata
    fwupdmgr get-updates || true
    ;;
  update)
    require_fwupdmgr
    print_bios_info
    echo
    echo "Verify the current BIOS/firmware version before updating."
    echo
    refresh_metadata
    if ! fwupdmgr get-updates; then
      echo
      echo "No firmware updates to apply."
      exit 0
    fi
    echo
    if confirm_update; then
      fwupdmgr update
    else
      echo "Firmware update cancelled."
    fi
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
