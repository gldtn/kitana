    "accentColor": "purple" // set accent color here
  },
  "palette": {
    // accent color palette
    "fgAccent": "accentColor",
    "bgAccent": "accentColor",
    "borderAccent": {
      "ref": "accentColor",
      "alpha": 0.12
    },
    "subtleAccent": {
      "ref": "accentColor",
      "alpha": 0.12
    },
    // fg color palette
    "fgPrimary": "foreground",
    "fgSecondary": "muted",
    "fgMuted": {
      "ref": "fgOnPrimary",
      "mix": "fgPrimary",
      "ratio": 0.25
    },
    "fgTertiary": "muted",
    "fgOnPrimary": "background",
    // bg color palette
    "bgPrimary": "background",
    "bgSecondary": {
      "ref": "background",
      "mix": "surface",
      "ratio": 0.6
    },
    "bgTertiary": {
      "ref": "surface",
      "lighten": 0.03
    },
    "bgOnPrimary": "foreground",
    // border color palette
    "borderDark": "bgPrimary",
    "borderLight": {
      "ref": "bgPrimary",
      "mix": "fgPrimary",
      "ratio": 0.14
    },
    "borderFaint": "border1",
    "borderHeavy": {
      "ref": "borderLight",
      "lighten": 0.04
    },
    // info color palette
    "info": "cyan",
    "success": "green",
    "warning": "yellow",
    "error": "red",
    // scrim color palette
    "scrimPrimary": {
      "ref": "bgPrimary",
      "lighten": 0.06
    },
    "scrimSecondary": {
      "ref": "bgSecondary",
      "lighten": 0.03
    },
    "scrimTertiary": {
      "ref": "bgTertiary",
      "lighten": 0.01
    },
    // subtle color palette
    "subtlePrimary": "scrimPrimary",
    "subtleSecondary": "scrimSecondary",
    "subtleTertiary": "scrimTertiary"
  },
  "icons": {
    "primary": "foreground",
    "secondary": "foreground",
    "muted": "muted",
    "subtle": "muted",
    "accent": "accentColor",
    "onAccent": "background",
    "inverse": "background",
    "brand": "purple",
    "disabled": {
      "ref": "muted",
      "alpha": 0.5
    },
    "danger": "red"
  },
  "hypr": {
    "border_active": "accentColor",
    "border_inactive": "borderHeavy"
  },
