{
  "slug": "cyberdream",
  "name": "Cyberdream",
  "mode": "dark",
  "colors": {
    "bg": "#16181a",
    "bg_alt": "#1e2124",
    "bg_highlight": "#3c4048",
    "fg": "#ffffff",
    "grey": "#7b8496",
    "blue": "#5ea1ff",
    "green": "#5eff6c",
    "cyan": "#5ef1ff",
    "red": "#ff6e5e",
    "yellow": "#f1ff5e",
    "magenta": "#ff5ef1",
    "pink": "#ff5ea0",
    "orange": "#ffbd5e",
    "purple": "#bd5eff",
    "accentColor": "blue" // set accent color here
  },
  "palette": {
    // accent color palette
    "fgAccent": "accentColor",
    "bgAccent": "accentColor",
    "borderAccent": {
      "ref": "accentColor",
      "alpha": 0.12
    },
    "subtleAccent": {
      "ref": "accentColor",
      "alpha": 0.12
    },
    // fg color palette
    "fgPrimary": "fg",
    "fgSecondary": "grey",
    "fgMuted": {
      "ref": "fgOnPrimary",
      "mix": "fgPrimary",
      "ratio": 0.25
    },
    "fgTertiary": {
      "ref": "fgPrimary",
      "mix": "accentColor",
      "ratio": 0.23
    },
    "fgOnPrimary": "bg",
    // bg color palette
    "bgPrimary": "bg",
    "bgSecondary": "bg_alt",
    "bgTertiary": "bg_highlight",
    "bgOnPrimary": "bgTertiary",
    // border color palette
    "borderDark": "bgPrimary",
    "borderFaint": {
      "ref": "grey",
      "darken": 0.6
    },
    "borderLight": {
      "ref": "bgPrimary",
      "mix": "fgPrimary",
      "ratio": 0.24
    },
    "borderHeavy": {
      "ref": "borderLight",
      "lighten": 0.04
    },
    // info color palette
    "info": "blue",
    "success": "green",
    "warning": "yellow",
    "error": "red",
    // scrim color palette
    "scrimPrimary": {
      "ref": "bg",
      "lighten": 0.09
    },
    "scrimSecondary": {
      "ref": "bg_alt",
      "lighten": 0.07
    },
    "scrimTertiary": {
      "ref": "bg_highlight",
      "lighten": 0.02
    },
    // subtle color palette
    "subtlePrimary": "scrimPrimary",
    "subtleSecondary": "scrimSecondary",
    "subtleTertiary": "scrimTertiary"
  },
  "icons": {
    "primary": "fg",
    "secondary": {
      "ref": "fg",
      "mix": "accentColor",
      "ratio": 0.38
    },
    "muted": "grey",
    "subtle": {
      "ref": "fg",
      "mix": "grey",
      "ratio": 0.5
    },
    "accent": "accentColor",
    "onAccent": "bg",
    "inverse": "bg",
    "brand": "blue",
    "disabled": {
      "ref": "grey",
      "alpha": 0.5
    },
    "danger": "red"
  },
  "hypr": {
    "border_active": "accentColor",
    "border_inactive": "borderHeavy"
  },
  "ghostty": {
    "source_file": "themes/integrations/ghostty/vendor/cyberdream"
  },
  "cava": {
    "source_file": "themes/integrations/cava/kitana/cyberdream.cava"
  },
  "zed": {
    "source_url": "https://raw.githubusercontent.com/scottmckendry/cyberdream.nvim/main/extras/zed/cyberdream.json",
    "source_file": "themes/integrations/zed/vendor/cyberdream.json",
    "theme_name": "Cyberdream dark"
  },
  "neovim": {
    "colorscheme": "cyberdream"
  }
}
