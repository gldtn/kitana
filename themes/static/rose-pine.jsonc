      "ref": "borderDark",
      "mix": "borderLight",
      "ratio": 0.43
    },
    "borderLight": {
      "ref": "bgPrimary",
      "mix": "fgPrimary",
      "ratio": 0.11
    },
    "borderHeavy": {
      "ref": "borderLight",
