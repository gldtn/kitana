{
  "slug": "catppuccin-mocha",
  "name": "Catppuccin Mocha",
  "mode": "dark",
  "colors": {
    "rosewater": "#f5e0dc",
    "flamingo": "#f2cdcd",
    "pink": "#f5c2e7",
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "maroon": "#eba0ac",
    "peach": "#fab387",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "sapphire": "#74c7ec",
    "blue": "#89b4fa",
    "lavender": "#b4befe",
    "text": "#cdd6f4",
    "subtext1": "#bac2de",
    "subtext0": "#a6adc8",
    "overlay2": "#9399b2",
    "overlay1": "#7f849c",
    "overlay0": "#6c7086",
    "surface2": "#585b70",
    "surface1": "#45475a",
    "surface0": "#313244",
    "base": "#1e1e2e",
    "mantle": "#181825",
    "crust": "#11111b",
    "accentColor": "mauve" // set accent color here
  },
  "palette": {
    // accent color palette
    "fgAccent": "accentColor",
    "bgAccent": "accentColor",
    "borderAccent": {
      "ref": "accentColor",
      "alpha": 0.12
    },
    "subtleAccent": {
      "ref": "accentColor",
      "alpha": 0.12
    },
    // fg color palette
    "fgPrimary": "text",
    "fgSecondary": "overlay2",
    "fgTertiary": "overlay2",
    "fgOnPrimary": "mantle",
    // bg color palette
    "bgPrimary": "base",
    "bgSecondary": "mantle",
    "bgTertiary": {
      "ref": "base",
      "lighten": 0.04
    },
    "bgOnPrimary": "mantle",
    // border color palette
    "borderDark": "bgPrimary",
    "borderLight": {
      "ref": "bgPrimary",
      "mix": "fgPrimary",
      "ratio": 0.12
    },
    "borderFaint": {
      "ref": "surface0",
      "darken": 0.2
    },
    "borderHeavy": {
      "ref": "borderLight",
      "lighten": 0.04
    },
    // info color palette
    "info": "blue",
    "success": "green",
    "warning": "yellow",
    "error": "red",
    // scrim color palette
    "scrimPrimary": {
      "ref": "crust",
      "lighten": 0.09
    },
    "scrimSecondary": {
      "ref": "mantle",
      "lighten": 0.03
    },
    "scrimTertiary": {
      "ref": "base",
      "lighten": 0.05
    },
    // subtle color palette
    "subtlePrimary": "scrimPrimary",
    "subtleSecondary": "scrimSecondary",
    "subtleTertiary": "scrimTertiary"
  },
  "icons": {
    "primary": "text",
    "secondary": "rosewater",
    "muted": "overlay2",
    "subtle": "overlay2",
    "accent": "accentColor",
    "onAccent": "mantle",
    "inverse": "mantle",
    "brand": "mauve",
    "disabled": {
      "ref": "overlay2",
      "alpha": 0.5
    },
    "danger": "red"
  },
  "hypr": {
    "border_active": "accentColor",
    "border_inactive": "borderHeavy"
  },
  "ghostty": {
    "theme": "Catppuccin Mocha"
  },
  "zed": {
    "source_url": "https://raw.githubusercontent.com/catppuccin/zed/main/themes/catppuccin-mauve.json",
    "source_file": "vendor/zed/catppuccin-mocha.json",
    "theme_name": "Catppuccin Mocha"
  },
  "neovim": {
    "colorscheme": "catppuccin"
  }
}
