    "blue5": "#89ddff",
    "blue6": "#b4f9f8",
    "blue7": "#394b70",
    "magenta": "#bb9af7",
    "magenta2": "#ff007c",
    "purple": "#9d7cd8",
    "orange": "#ff9e64",
    "yellow": "#e0af68",
    "green": "#9ece6a",
    "green1": "#73daca",
    "green2": "#41a6b5",
    "teal": "#1abc9c",
    "red": "#f7768e",
    "red1": "#db4b4b",
    "white": "#ffffff",
    "accentColor": "blue"
  },
  "palette": {
    // accent color palette
    "fgAccent": "accentColor",
    "bgAccent": "accentColor",
    "borderAccent": {
      "ref": "accentColor",
      "alpha": 0.12
    },
    "subtleAccent": {
      "ref": "accentColor",
      "alpha": 0.12
    },
    // fg color palette
    "fgPrimary": "fg",
    "fgSecondary": "dark3",
    "fgTertiary": "dark5",
    "fgOnPrimary": "bg_dark",
    // bg color palette
    "bgPrimary": "bg",
    "bgSecondary": {
      "ref": "bg",
      "lighten": 0.03
    },
    "bgTertiary": {
      "ref": "dark5",
      "darken": 0.6
    },
    "bgOnPrimary": "terminal_black",
    // border color palette
    "borderDark": "bgPrimary",
    "borderFaint": {
      "ref": "bgPrimary",
      "lighten": 0.09
    },
    "borderLight": {
      "ref": "bgPrimary",
      "mix": "fgPrimary",
      "ratio": 0.21
    },
    "borderHeavy": {
      "ref": "borderLight",
      "lighten": 0.04
    },
    // info color palette
    "info": "blue",
    "success": "green",
    "warning": "yellow",
    "error": "red",
    // scrim color palette
    "scrimPrimary": {
      "ref": "bg",
      "lighten": 0.06
    },
    "scrimSecondary": {
      "ref": "bg",
      "mix": "fg",
      "ratio": 0.09
    },
    "scrimTertiary": {
      "ref": "bgTertiary",
      "lighten": 0.01
    },
    // subtle color palette
    "subtlePrimary": "scrimPrimary",
    "subtleSecondary": "scrimSecondary",
    "subtleTertiary": "scrimTertiary"
  },
  "icons": {
    "primary": "fg",
    "secondary": "terminal_black",
    "muted": "fg_gutter",
    "subtle": {
      "ref": "fg_dark",
      "darken": 0.2
    },
    "accent": "accentColor",
    "onAccent": "bg",
    "inverse": "white",
    "brand": "blue",
    "disabled": {
      "ref": "dark5",
      "alpha": 0.5
    },
    "danger": "red"
  },
  "hypr": {
    "border_active": "accentColor",
    "border_inactive": "borderHeavy"
  },
  "ghostty": {
    "theme": "TokyoNight"
  },
  "zed": {
