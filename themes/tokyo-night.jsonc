    "fg_dark": "#a9b1d6",
    "fg_gutter": "#3b4261",
    "comment": "#565f89",
    "dark3": "#545c7e",
    "dark5": "#737aa2",
    "blue0": "#3d59a1",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "blue1": "#2ac3de",
