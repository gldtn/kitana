{
  "slug": "cyberdream",
  "name": "Cyberdream",
  "mode": "dark",
  "colors": {
    "bg": "#16181a",
    "bg_alt": "#1e2124",
    "bg_highlight": "#3c4048",
    "fg": "#ffffff",
    "grey": "#7b8496",
    "blue": "#5ea1ff",
    "green": "#5eff6c",
    "cyan": "#5ef1ff",
    "red": "#ff6e5e",
    "yellow": "#f1ff5e",
    "magenta": "#ff5ef1",
    "pink": "#ff5ea0",
    "orange": "#ffbd5e",
    "purple": "#bd5eff",
    // custom colors
    "fg_subtle": {
      "ref": "fg",
      "darken": 0.5
    },
    "surface_control": "#363a41",
    "surface_hover": "#3b3f47",
    "surface_pressed": "#3e424a",
    "surface_floating": "#2d3036",
    "border": "#3a3e46",
    "border_subtle": "#505662",
    "border_strong": "#6f7787"
  },
  "palette": {
    "fgPrimary": "fg",
    "fgSecondary": "grey",
    "fgTertiary": "fg_subtle",
    "fgOnPrimary": "bg",
    "fgAccent": "orange",
    "bgPrimary": "bg",
    "bgSecondary": "bg_alt",
    "bgTertiary": "bg_highlight",
    "bgOnPrimary": "bg",
    "bgAccent": "orange",
    "borderDark": "bg",
    "borderFaint": {
      "ref": "grey",
      "darken": 0.6
    },
    "borderLight": {
      "ref": "bg",
      "mix": "fg",
      "ratio": 0.26
    },
    "borderHeavy": {
      "ref": "borderLight",
      "mix": "borderDark",
      "ratio": 0.16
    },
    "borderAccent": "orange",
    "info": "blue",
    "success": "green",
    "warning": "yellow",
    "error": "red",
    "scrimPrimary": {
      "ref": "bg",
      "lighten": 0.09
    },
    "scrimSecondary": {
      "ref": "bg_alt",
      "lighten": 0.07
    },
    "scrimTertiary": {
      "ref": "bg_highlight",
      "lighten": 0.02
    },
    "subtleAccent": {
      "ref": "orange",
      "alpha": 0.16
    },
    "subtlePrimary": "scrimPrimary",
    "subtleSecondary": "scrimSecondary",
    "subtleTertiary": "scrimTertiary"
  },
  "icons": {
    "primary": "fg",
    "secondary": "red",
    "muted": "grey",
    "subtle": {
      "ref": "fg",
      "mix": "grey",
      "ratio": 0.5
    },
    "accent": "orange",
    "onAccent": "bg",
    "inverse": "bg",
    "brand": "blue",
    "disabled": {
      "ref": "grey",
      "alpha": 0.5
    },
    "danger": "red"
  },
  "hypr": {
    "border_active": "borderAccent",
    "border_inactive": "borderHeavy"
  },
  "ghostty": {
    "source_file": "vendor/ghostty/cyberdream"
  },
  "zed": {
    "source_url": "https://raw.githubusercontent.com/scottmckendry/cyberdream.nvim/main/extras/zed/cyberdream.json",
    "source_file": "vendor/zed/cyberdream.json",
    "theme_name": "Cyberdream dark"
  },
  "neovim": {
    "colorscheme": "cyberdream"
  }
}
